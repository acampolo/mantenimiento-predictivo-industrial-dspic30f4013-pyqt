# PALETA GLOBAL
# ══════════════════════════════════════════════════════════════════════════════
C_BG        = '#0A0E1A'
C_AX_BG     = '#0D1525'
C_PANEL     = '#0F1830'
C_BORDER    = '#1A3060'
C_GRID      = '#152040'
C_VIB       = '#00FFCC'
C_CORR      = '#FF8C00'
C_VIB_RAW   = '#FF00FF'
C_CORR_RAW  = '#FFE000'
C_REF       = '#39FF14'
C_ALARM     = '#FF3333'
C_EMA       = '#00BFFF'
C_RAW_DIM   = '#FF6B6B'
C_TEXT      = '#C8D8F0'
C_TEXT_DIM  = '#556688'


def _estilizar_ax(ax, titulo, ylabel_izq, color_izq):
    ax.set_facecolor(C_AX_BG)
    ax.set_title(titulo, color='#AACCFF', fontsize=9, fontweight='bold', pad=6)
    ax.tick_params(colors='#6688AA', labelsize=7)
    ax.set_ylabel(ylabel_izq, color=color_izq, fontsize=8)
    ax.yaxis.label.set_color(color_izq)
    ax.tick_params(axis='y', labelcolor=color_izq)
    for spine in ax.spines.values():
        spine.set_edgecolor(C_BORDER)
    ax.grid(True, color=C_GRID, linestyle='--', linewidth=0.5, alpha=0.8)
    ax.set_xlabel("Muestras", color=C_TEXT_DIM, fontsize=7)


# ══════════════════════════════════════════════════════════════════════════════
# WIDGET: DISPLAY DIGITAL (indicador tipo instrumento)
# ══════════════════════════════════════════════════════════════════════════════
class DisplayDigital(QWidget):
    """Indicador numérico estilo instrumento industrial."""

    def __init__(self, titulo, unidad, color_acento, min_val=0, max_val=100, parent=None):
        super().__init__(parent)
        self.titulo     = titulo
        self.unidad     = unidad
        self.color      = QColor(color_acento)
        self.min_val    = min_val
        self.max_val    = max_val
        self.valor      = 0.0
        self.setMinimumSize(160, 110)
        self.setMaximumSize(220, 130)

    def set_valor(self, v):
        self.valor = float(v)
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        w, h = self.width(), self.height()

        # Fondo con borde
        p.setPen(QPen(self.color.darker(180), 1))
        grad = QLinearGradient(0, 0, 0, h)
        grad.setColorAt(0, QColor('#0D1830'))
        grad.setColorAt(1, QColor('#070C18'))
        p.setBrush(QBrush(grad))
        p.drawRoundedRect(1, 1, w - 2, h - 2, 8, 8)

        # Barra de progreso inferior
        pct = max(0.0, min(1.0, (self.valor - self.min_val) / max(1, self.max_val - self.min_val)))
        bar_w = int((w - 16) * pct)
        p.setPen(Qt.NoPen)
        p.setBrush(QBrush(self.color.darker(200)))
        p.drawRoundedRect(8, h - 14, w - 16, 8, 3, 3)
        if bar_w > 0:
            bar_color = self.color if pct < 0.75 else QColor('#FF5533')
            p.setBrush(QBrush(bar_color))
            p.drawRoundedRect(8, h - 14, bar_w, 8, 3, 3)

        # Título
        p.setPen(QPen(self.color.lighter(130)))
        p.setFont(QFont("Consolas", 8, QFont.Bold))
        p.drawText(8, 18, self.titulo.upper())

        # Valor numérico grande
        texto_val = f"{self.valor:.1f}"
        p.setPen(QPen(QColor('white')))
        p.setFont(QFont("Consolas", 26, QFont.Bold))
        fm = p.fontMetrics()
        tw = fm.horizontalAdvance(texto_val)
        p.drawText(w - tw - 40, 62, texto_val)

        # Unidad
        p.setPen(QPen(self.color))
        p.setFont(QFont("Consolas", 10))
        p.drawText(w - 36, 62, self.unidad)

        p.end()


# ══════════════════════════════════════════════════════════════════════════════
# WIDGET: PANEL DE DATOS EN VIVO (muestra valores numéricos actuales)
# ══════════════════════════════════════════════════════════════════════════════
class PanelDatosVivo(QWidget):
    """Barra de datos numéricos en tiempo real para cada pestaña."""

    def __init__(self, campos, parent=None):
        """
        campos: lista de (clave, etiqueta, unidad, color)
        """
        super().__init__(parent)
        self._campos = campos
        self._valores = {c[0]: 0.0 for c in campos}
        self.setFixedHeight(52)
        self.setStyleSheet(
            f"background:{C_PANEL};"
            f"border:1px solid {C_BORDER};"
            "border-radius:5px;"
        )
        layout = QHBoxLayout()
        layout.setContentsMargins(10, 4, 10, 4)
        layout.setSpacing(16)

        self._labels = {}
        for clave, etiqueta, unidad, color in campos:
            col_layout = QVBoxLayout()
            col_layout.setSpacing(0)

            lbl_titulo = QLabel(etiqueta.upper())
            lbl_titulo.setFont(QFont("Consolas", 7, QFont.Bold))
            lbl_titulo.setStyleSheet(f"color:{C_TEXT_DIM};background:transparent;border:none;")
            lbl_titulo.setAlignment(Qt.AlignCenter)

            lbl_valor = QLabel("—")
            lbl_valor.setFont(QFont("Consolas", 14, QFont.Bold))
            lbl_valor.setStyleSheet(f"color:{color};background:transparent;border:none;")
            lbl_valor.setAlignment(Qt.AlignCenter)
            lbl_valor.setMinimumWidth(90)

            col_layout.addWidget(lbl_titulo)
            col_layout.addWidget(lbl_valor)

            self._labels[clave] = (lbl_valor, unidad)
            layout.addLayout(col_layout)

            # Separador vertical entre campos
            if campos.index((clave, etiqueta, unidad, color)) < len(campos) - 1:
                sep = QFrame()
                sep.setFrameShape(QFrame.VLine)
                sep.setStyleSheet(f"color:{C_BORDER};background:{C_BORDER};border:none;max-width:1px;")
                layout.addWidget(sep)

        self.setLayout(layout)

    def actualizar(self, datos: dict):
        for clave, (lbl, unidad) in self._labels.items():
            val = datos.get(clave, 0.0)
            if isinstance(val, float):
                lbl.setText(f"{val:.1f} {unidad}")
            else:
                lbl.setText(f"{val} {unidad}")


# ══════════════════════════════════════════════════════════════════════════════
# PANEL HMI PRINCIPAL
# ══════════════════════════════════════════════════════════════════════════════
class PanelHMI(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("SCADA / HMI Edge Computing — Mantenimiento Predictivo")
        self.resize(1280, 860)
        self.setStyleSheet(f"""
            QMainWindow, QWidget {{ background-color: {C_BG}; color: {C_TEXT}; }}
            QGroupBox {{
                border: 1px solid {C_BORDER};
                border-radius: 6px;
                margin-top: 10px;
                font-weight: bold;
                color: #7AAFFF;
                font-size: 9pt;
            }}
            QGroupBox::title {{ subcontrol-origin: margin; left: 10px; padding: 0 5px; }}
            QComboBox, QLineEdit {{
                background-color: #0D1525;
                border: 1px solid {C_BORDER};
                border-radius: 4px;
                padding: 4px 8px;
                color: {C_TEXT};
            }}
            QTabWidget::pane {{ border: 1px solid {C_BORDER}; background: {C_BG}; }}
            QTabBar::tab {{
                background: #0D1525;
                padding: 7px 14px;
                color: #6090B0;
                border-top-left-radius: 4px;
                border-top-right-radius: 4px;
                font-size: 8pt;
            }}
            QTabBar::tab:selected {{ background: {C_PANEL}; color: #00FFCC; font-weight: bold; }}
            QTabBar::tab:hover   {{ background: #142035; color: #AADDFF; }}
            QSlider::groove:horizontal {{
                background: #0D1525; border: 1px solid {C_BORDER};
                height: 6px; border-radius: 3px;
            }}
            QSlider::handle:horizontal {{
                background: #00BFFF; width: 14px; height: 14px;
                margin: -4px 0; border-radius: 7px;
            }}
            QSlider::sub-page:horizontal {{ background: #004466; border-radius: 3px; }}
        """)

        self.MAX_DATOS = 60
        self.LIM_VIB   = 50
        self.LIM_CORR  = 800

        self.hist_v_p1   = [0.0] * self.MAX_DATOS
        self.hist_c_p1   = [0.0] * self.MAX_DATOS
        self.hist_v_p2   = [0.0] * self.MAX_DATOS
        self.hist_c_p2   = [0.0] * self.MAX_DATOS
        self.matriz_fft  = np.zeros((32, self.MAX_DATOS))

        # Para pestaña didáctica EMA
        self.hist_raw_didact  = [0.0] * self.MAX_DATOS
        self.hist_ema_didact  = [0.0] * self.MAX_DATOS
        self.ema_sim          = 0.0
        self.alpha_didact     = 0.125   # 1/8 = shift 3

        # Para pestaña didáctica RMS
        self.hist_rms_didact  = [0.0] * self.MAX_DATOS

        # Para pestaña didáctica FFT
        self.fft_bins         = np.zeros(32)

        # ── Estado predictivo (retención de último valor válido) ──────────────
        self._ultimo_valido = {
            'rpm': 0, 'c_proc': 0.0, 'v_proc': 0.0,
            'c_crud': 0.0, 'v_crud': 0.0,
            'ref_sana': 0, 'bin_dom': 0, 'alertas': 0
        }
        self._modo_prediccion   = False
        self._ciclos_prediccion = 0
        self._MAX_CICLOS_PRED   = 8

        # ── RUL — Remaining Useful Life ──────────────────────────────────────
        # Datos de placa (se cargan desde la UI)
        self._placa = {
            'rpm_nom':    1750.0,   # RPM nominales
            'i_vacio':    80.0,     # Corriente en vacío [mA]
            'i_nom':      300.0,    # Corriente nominal con carga [mA]
            'i_bloq':     900.0,    # Corriente de bloqueo/arranque [mA]
            'vib_nom':    5.0,      # Vibración nominal sana [u.a.]
            'vida_nom':   17520.0,  # Vida útil nominal del fabricante [horas]
        }
        self._placa_cargada   = False        # True cuando el usuario confirmó los datos
        self._rul_activo      = False        # True cuando hay suficiente historial

        # Historial largo para RUL (500 muestras ≈ 4 min a 500 ms/ciclo)
        self._MAX_HIST_RUL   = 500
        self._hist_di        = []            # Degradation Index acumulado
        self._hist_di_t      = []            # timestamps (índice de muestra)
        self._muestra_global = 0             # contador global de muestras

        # Vector de señal sana de referencia (se calcula al confirmar placa)
        self._ref_sano  = None               # np.array [c_norm, v_norm, rpm_norm]
        self._std_sano  = None               # desviación estándar del estado sano

        # RUL calculado
        self._rul_horas      = None
        self._rul_std_horas  = None
        self._di_umbral      = 3.0           # DI > 3σ → falla inminente

        # ── Diagnóstico de falla ──────────────────────────────────────────────
        self._historial_eventos  = []    # lista de dicts con cada evento registrado
        self._sobrecarga_count   = 0     # contador acumulado de sobrecargas
        self._desbalance_count   = 0     # contador acumulado de desbalances
        self._horas_acum         = 0.0   # horas de operación acumuladas (desde inicio)
        self._timer_horas        = QTimer()
        self._timer_horas.timeout.connect(self._tick_horas)
        # arranca cuando el usuario pulsa Iniciar (en _iniciar)

        # ── Mantenimiento preventivo ──────────────────────────────────────────
        # Intervalos base según ISO 10816 / NEMA MG1 / IEEE 1099 [horas]
        self._INTERVALO_BASE = {
            'rodamientos':   4000,
            'lubricacion':   2000,
            'escobillas':    1000,
            'aislamiento':   8760,   # 1 año
            'limpieza':       500,
            'correas':       3000,
        }
        self._prox_mant = dict(self._INTERVALO_BASE)  # próxima intervención en horas

        # ── Base de datos + firma + tendencia ────────────────────────────────
        self._db              = DBManager()
        self._firma           : AnalizadorFirma | None = None
        self._firma_ref_vec   = None          # vector de referencia sano
        self._similitud_sesion: float | None  = None
        self._tendencia       = DetectorTendencia()
        self._muestra_sesion  = 0             # índice de muestra dentro de la sesión actual
        self._di_sesion       : list[float]   = []
        # Cargar historial de tendencia de BD
        self._cargar_tendencia_bd()

        self.hilo_trabajo = None
        self._construir_interfaz()

    # ──────────────────────────────────────────────────────────────────────────
    def _construir_interfaz(self):
        central = QWidget()
        layout  = QVBoxLayout()
        layout.setSpacing(5)
        layout.setContentsMargins(8, 8, 8, 8)

        # ── Panel de control ─────────────────────────────────────────────────
        grp = QGroupBox("Panel de Control del Nodo")
        row = QHBoxLayout(); row.setSpacing(8)

        self.combo_sensor = QComboBox()
        self.combo_sensor.addItems(["1 - ACS712 (5A)", "2 - ACS712 (30A)", "3 - ACS758 (50A)"])
        self.combo_vent = QComboBox()
        self.combo_vent.addItems(["0 - Apagado", "1 - Encendido"])
        self.input_rpm = QLineEdit(); self.input_rpm.setPlaceholderText("RPM (10–10000)")
        self.input_rpm.setFixedWidth(130)

        self.btn_iniciar = QPushButton("▶  Iniciar")
        self.btn_iniciar.setStyleSheet(
            "QPushButton{background:#003D14;color:#00FF66;border:1px solid #00AA33;"
            "border-radius:5px;font-weight:bold;padding:6px 14px;}"
            "QPushButton:hover{background:#005020;}"
            "QPushButton:disabled{background:#141E14;color:#334433;border-color:#223322;}")
        self.btn_detener = QPushButton("■  Detener")
        self.btn_detener.setStyleSheet(
            "QPushButton{background:#3D0000;color:#FF4444;border:1px solid #AA2222;"
            "border-radius:5px;font-weight:bold;padding:6px 14px;}"
            "QPushButton:hover{background:#550000;}"
            "QPushButton:disabled{background:#1E1414;color:#443333;border-color:#332222;}")
        self.btn_detener.setEnabled(False)

        for lbl, w in [("Sensor:", self.combo_sensor),
                       ("Carga/Vent:", self.combo_vent),
                       ("RPM:", self.input_rpm)]:
            row.addWidget(QLabel(lbl)); row.addWidget(w)
        row.addStretch()
        row.addWidget(self.btn_iniciar)
        row.addWidget(self.btn_detener)
        grp.setLayout(row)
        layout.addWidget(grp)

        # ── Barra de telemetría + displays digitales ─────────────────────────
        tel_row = QHBoxLayout(); tel_row.setSpacing(8)

        self.disp_vib  = DisplayDigital("Vibración", "u.a", C_VIB,  0, self.LIM_VIB * 1.5)
        self.disp_corr = DisplayDigital("Corriente", "mA",  C_CORR, 0, self.LIM_CORR * 1.5)
        self.disp_rpm  = DisplayDigital("RPM",       "rpm", "#AA88FF", 0, 10000)

        self.label_tel = QLabel("●  EN ESPERA DE ARRANQUE")
        self.label_tel.setAlignment(Qt.AlignCenter)
        self.label_tel.setFont(QFont("Consolas", 12, QFont.Bold))
        self.label_tel.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        self.label_tel.setStyleSheet(
            f"background:{C_BG};color:#00FFCC;"
            f"border:1px solid #00FFCC;border-radius:4px;padding:4px;")

        tel_row.addWidget(self.disp_vib)
        tel_row.addWidget(self.disp_corr)
        tel_row.addWidget(self.disp_rpm)
        tel_row.addWidget(self.label_tel, stretch=3)
        layout.addLayout(tel_row)

        # ── Tabs principales ─────────────────────────────────────────────────
        self.tabs = QTabWidget()

        # Tab 1 — EMA + FFT
        t1 = QWidget(); l1 = QVBoxLayout(); l1.setContentsMargins(0,0,0,0)
        self._crear_tab_procesado(l1); t1.setLayout(l1)

        # Tab 2 — Crudo
        t2 = QWidget(); l2 = QVBoxLayout(); l2.setContentsMargins(0,0,0,0)
        self._crear_tab_crudo(l2); t2.setLayout(l2)

        # Tab 3 — Didáctica (sub-tabs)
        t3 = self._crear_tab_didactica()

        # Tab 4 — RUL / Vida Útil
        t4 = self._crear_tab_rul()

        # Tab 5 — Historial + Firma + Tendencia
        t5 = self._crear_tab_historico()

        self.tabs.addTab(t1, "📈  Análisis Predictivo")
        self.tabs.addTab(t2, "📡  Telemetría Cruda")
        self.tabs.addTab(t3, "🔬  Laboratorio de Filtros")
        self.tabs.addTab(t4, "⏳  Vida Útil / RUL")
        self.tabs.addTab(t5, "📊  Historial & Tendencia")

        layout.addWidget(self.tabs)
        central.setLayout(layout)
        self.setCentralWidget(central)

        self.btn_iniciar.clicked.connect(self._iniciar)
        self.btn_detener.clicked.connect(self._detener)

    # ══════════════════════════════════════════════════════════════════════════
    # TAB 1 — PROCESADO (con panel de datos en vivo arriba)
    # ══════════════════════════════════════════════════════════════════════════
    def _crear_tab_procesado(self, layout):
        # ── Panel de datos en vivo — Tab 1 ───────────────────────────────────
        self.panel_datos_t1 = PanelDatosVivo([
            ('v_proc',   'VIB (EMA)',  'u.a', C_VIB),
            ('c_proc',   'CORR (EMA)', 'mA',  C_CORR),
            ('rpm',      'RPM',        'rpm', '#AA88FF'),
            ('ref_sana', 'REF SANA',  'mA',  C_REF),
            ('bin_dom',  'BIN DOM',   '',    '#FF88AA'),
        ])
        layout.addWidget(self.panel_datos_t1)

        self.fig_p1 = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_p1  = FigureCanvas(self.fig_p1)
        self.cv_p1.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        gs = gridspec.GridSpec(2, 1, figure=self.fig_p1, hspace=0.38)

        # Subplot superior
        self.ax_v1 = self.fig_p1.add_subplot(gs[0])
        _estilizar_ax(self.ax_v1, "Vibración y Corriente Filtradas (EMA)", "Vibración [u.a.]", C_VIB)

        self.line_v1, = self.ax_v1.plot([], [], color=C_VIB,  lw=1.5, label='Vibración (EMA)')
        self.ax_v1.axhline(self.LIM_VIB, color=C_ALARM, ls='--', lw=0.8, alpha=0.7, label=f'Límite Vib ({self.LIM_VIB})')

        self.ax_c1 = self.ax_v1.twinx()
        self.ax_c1.set_ylabel("Corriente [mA]", color=C_CORR, fontsize=8)
        self.ax_c1.tick_params(axis='y', labelcolor=C_CORR, labelsize=7)
        self.ax_c1.spines['right'].set_edgecolor(C_CORR)
        self.line_c1, = self.ax_c1.plot([], [], color=C_CORR, lw=1.5, label='Corriente (EMA)')
        self.line_ref = self.ax_c1.axhline(0, color=C_REF, ls=':', lw=1.2, alpha=0.9, label='Ref. Sana')
        self.ax_c1.axhline(self.LIM_CORR, color=C_ALARM, ls='--', lw=0.8, alpha=0.6)

        self.ax_v1.set_xlim(0, self.MAX_DATOS - 1)
        self.ax_v1.set_ylim(0, self.LIM_VIB * 1.6)
        self.ax_c1.set_ylim(0, self.LIM_CORR * 1.6)

        h1, l1 = self.ax_v1.get_legend_handles_labels()
        h2, l2 = self.ax_c1.get_legend_handles_labels()
        self.ax_v1.legend(h1+h2, l1+l2, loc='upper left', fontsize=7,
                          facecolor='#0A1020', edgecolor=C_BORDER, labelcolor='white')

        # Subplot inferior — Espectrograma
        self.ax_fft = self.fig_p1.add_subplot(gs[1])
        self.ax_fft.set_facecolor('black')
        self.ax_fft.set_title("Espectrograma en Cascada (FFT)", color='#AACCFF', fontsize=9, fontweight='bold', pad=6)
        self.ax_fft.set_ylabel("Bin Frecuencia", color='#8899BB', fontsize=8)
        self.ax_fft.set_xlabel("Muestras (tiempo →)", color=C_TEXT_DIM, fontsize=7)
        self.ax_fft.tick_params(colors='#6688AA', labelsize=7)
        for s in self.ax_fft.spines.values(): s.set_edgecolor(C_BORDER)
        self.img_fft = self.ax_fft.imshow(
            self.matriz_fft, aspect='auto', cmap='plasma', origin='lower',
            vmin=0, vmax=self.LIM_VIB/2, extent=[0, self.MAX_DATOS, 0, 31],
            interpolation='bilinear')
        cb = self.fig_p1.colorbar(self.img_fft, ax=self.ax_fft, fraction=0.025, pad=0.02)
        cb.ax.tick_params(colors='#8899BB', labelsize=7)
        cb.set_label('Amplitud', color='#8899BB', fontsize=7)

        layout.addWidget(self.cv_p1)

    # ══════════════════════════════════════════════════════════════════════════
    # TAB 2 — CRUDO (con panel de datos crudos en vivo arriba)
    # ══════════════════════════════════════════════════════════════════════════
    def _crear_tab_crudo(self, layout):
        # ── Panel de datos en vivo — Tab 2 ───────────────────────────────────
        self.panel_datos_t2 = PanelDatosVivo([
            ('v_crud',  'VIB CRUDA',  'u.a', C_VIB_RAW),
            ('c_crud',  'CORR CRUDA', 'mA',  C_CORR_RAW),
            ('rpm',     'RPM',        'rpm', '#AA88FF'),
            ('bin_dom', 'BIN DOM',   '',    '#FF88AA'),
            ('alertas', 'ALERTAS',   '',    C_ALARM),
        ])
        layout.addWidget(self.panel_datos_t2)

        self.fig_p2 = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_p2  = FigureCanvas(self.fig_p2)
        self.cv_p2.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        self.ax_v2 = self.fig_p2.add_subplot(111)
        _estilizar_ax(self.ax_v2, "Picos Crudos en Tiempo Real (sin filtro)", "Vibración pico [u.a.]", C_VIB_RAW)

        self.line_v2, = self.ax_v2.plot([], [], color=C_VIB_RAW, lw=1.3, label='Vib Cruda',
                                        marker='o', markersize=2, markerfacecolor=C_VIB_RAW)
        self.ax_v2.axhline(self.LIM_VIB*1.2, color=C_ALARM, ls='--', lw=0.8, alpha=0.7, label='Umbral')

        self.ax_c2 = self.ax_v2.twinx()
        self.ax_c2.set_ylabel("Corriente pico [mA]", color=C_CORR_RAW, fontsize=8)
        self.ax_c2.tick_params(axis='y', labelcolor=C_CORR_RAW, labelsize=7)
        self.ax_c2.spines['right'].set_edgecolor(C_CORR_RAW)
        self.line_c2, = self.ax_c2.plot([], [], color=C_CORR_RAW, lw=1.3, label='Corriente Cruda',
                                         marker='o', markersize=2, markerfacecolor=C_CORR_RAW)

        self.ax_v2.set_xlim(0, self.MAX_DATOS - 1)
        self.ax_v2.set_ylim(0, self.LIM_VIB * 1.8)
        self.ax_c2.set_ylim(0, self.LIM_CORR * 1.8)

        h1, l1 = self.ax_v2.get_legend_handles_labels()
        h2, l2 = self.ax_c2.get_legend_handles_labels()
        self.ax_v2.legend(h1+h2, l1+l2, loc='upper left', fontsize=7,
                          facecolor='#0A1020', edgecolor=C_BORDER, labelcolor='white')
        layout.addWidget(self.cv_p2)

    # ══════════════════════════════════════════════════════════════════════════
    # TAB 3 — LABORATORIO DE FILTROS (sub-tabs)
    # ══════════════════════════════════════════════════════════════════════════
    def _crear_tab_didactica(self):
        contenedor = QWidget()
        layout = QVBoxLayout(); layout.setContentsMargins(4, 4, 4, 4)

        self.sub_tabs = QTabWidget()
        self.sub_tabs.setStyleSheet(
            "QTabBar::tab{background:#0A1020;padding:5px 10px;color:#557799;font-size:8pt;}"
            "QTabBar::tab:selected{background:#0F1830;color:#FFD700;font-weight:bold;}"
        )

        self.sub_tabs.addTab(self._tab_ema(),       "① EMA — Filtro Exponencial")
        self.sub_tabs.addTab(self._tab_rms(),       "② True RMS")
        self.sub_tabs.addTab(self._tab_fft(),       "③ FFT — Espectro")
        self.sub_tabs.addTab(self._tab_pasabaja(),  "④ Pasa-Bajas (RPM)")

        layout.addWidget(self.sub_tabs)
        contenedor.setLayout(layout)
        return contenedor

    # ── Sub-tab EMA ───────────────────────────────────────────────────────────
    def _tab_ema(self):
        w = QWidget(); main = QVBoxLayout(); main.setSpacing(6)

        # Panel de datos en vivo — EMA
        self.panel_datos_ema = PanelDatosVivo([
            ('v_crud', 'VIB CRUDA', 'u.a', C_RAW_DIM),
            ('v_proc', 'VIB (EMA)', 'u.a', C_EMA),
            ('c_proc', 'CORR(EMA)', 'mA',  C_CORR),
            ('rpm',    'RPM',       'rpm', '#AA88FF'),
        ])
        main.addWidget(self.panel_datos_ema)

        # Explicación matemática
        math_box = QLabel(
            "<b style='color:#FFD700;font-size:10pt;'>Filtro EMA — Exponential Moving Average</b><br><br>"
            "<span style='color:#00FFCC;font-family:Consolas;font-size:10pt;'>"
            "EMA[n] = EMA[n-1] + α · (x[n] − EMA[n-1])</span><br><br>"
            "<span style='color:#AADDFF;'>"
            "En el dsPIC se implementa con desplazamiento binario:<br>"
            "<span style='color:#FFD700;font-family:Consolas;'>EMA += (nueva_muestra − EMA) >> 3</span><br>"
            "→ equivale a α = 1/8 = 0.125<br><br>"
            "• α grande (≈1.0): sigue la señal rápido, deja pasar ruido<br>"
            "• α pequeño (≈0.05): muy suave, reacciona lento ante cambios reales<br>"
            "• El dsPIC usa α=0.125: equilibrio para señales de motor industrial"
            "</span>"
        )
        math_box.setWordWrap(True)
        math_box.setStyleSheet(
            f"background:{C_PANEL};border:1px solid {C_BORDER};"
            "border-radius:6px;padding:10px;")
        main.addWidget(math_box)

        # Control de alpha
        alpha_row = QHBoxLayout()
        alpha_row.addWidget(QLabel("α (factor de suavizado):"))
        self.slider_alpha = QSlider(Qt.Horizontal)
        self.slider_alpha.setRange(1, 99)
        self.slider_alpha.setValue(int(self.alpha_didact * 100))
        self.lbl_alpha = QLabel(f"{self.alpha_didact:.2f}  (dsPIC >> {self._alpha_to_shift(self.alpha_didact)})")
        self.lbl_alpha.setStyleSheet("color:#FFD700;font-family:Consolas;min-width:200px;")
        self.slider_alpha.valueChanged.connect(self._on_alpha_change)
        alpha_row.addWidget(self.slider_alpha, stretch=1)
        alpha_row.addWidget(self.lbl_alpha)
        main.addLayout(alpha_row)

        # Gráfico EMA
        self.fig_ema = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_ema  = FigureCanvas(self.fig_ema)
        self.cv_ema.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        self.ax_ema = self.fig_ema.add_subplot(111)
        _estilizar_ax(self.ax_ema, "Señal Cruda vs EMA (efecto del filtro en tiempo real)", "Amplitud", C_EMA)
        self.line_raw_ema, = self.ax_ema.plot([], [], color=C_RAW_DIM, lw=0.9, alpha=0.7,
                                               label='Señal cruda (vibración)')
        self.line_ema_out, = self.ax_ema.plot([], [], color=C_EMA, lw=2.0, label='Salida EMA')
        self.ax_ema.set_xlim(0, self.MAX_DATOS - 1)
        self.ax_ema.set_ylim(0, self.LIM_VIB * 2)
        self.ax_ema.legend(loc='upper left', fontsize=7,
                           facecolor='#0A1020', edgecolor=C_BORDER, labelcolor='white')
        self.ax_ema.fill_between(range(self.MAX_DATOS), 0, 0,
                                  color=C_EMA, alpha=0.08)
        main.addWidget(self.cv_ema)
        w.setLayout(main); return w

    def _alpha_to_shift(self, alpha):
        if alpha <= 0: return "∞"
        shift = round(-np.log2(alpha))
        return str(int(max(0, shift)))

    def _on_alpha_change(self, val):
        self.alpha_didact = val / 100.0
        self.ema_sim = 0.0
        shift = self._alpha_to_shift(self.alpha_didact)
        self.lbl_alpha.setText(f"{self.alpha_didact:.2f}  (dsPIC >> {shift})")

    # ── Sub-tab True RMS ──────────────────────────────────────────────────────
    def _tab_rms(self):
        w = QWidget(); main = QVBoxLayout(); main.setSpacing(6)

        # Panel de datos en vivo — RMS
        self.panel_datos_rms = PanelDatosVivo([
            ('c_proc', 'TRUE RMS',   'mA',  C_CORR),
            ('c_crud', 'PICO CRUDO', 'mA',  C_CORR_RAW),
            ('rpm',    'RPM',        'rpm', '#AA88FF'),
        ])
        main.addWidget(self.panel_datos_rms)

        math_box = QLabel(
            "<b style='color:#FFD700;font-size:10pt;'>True RMS — Valor Eficaz Real</b><br><br>"
            "<span style='color:#00FFCC;font-family:Consolas;font-size:10pt;'>"
            "RMS = √( (1/N) · Σ x²[i] )</span><br><br>"
            "<span style='color:#AADDFF;'>"
            "Implementación en el dsPIC:<br>"
            "<span style='color:#FFD700;font-family:Consolas;'>"
            "1. Restar offset DC: valor_ac = ADC[i] − 2048 − offset_dc<br>"
            "2. Acumular cuadrados: suma += valor_ac²<br>"
            "3. Media: media = suma >> 6  (÷64 muestras)<br>"
            "4. Raíz entera: RMS = integer_sqrt(media)<br>"
            "5. Convertir a mA: mA = (RMS × factor_sensor) ÷ 1000</span><br><br>"
            "El True RMS es más preciso que el valor pico para corrientes no sinusoidales.<br>"
            "Un simple valor pico sobreestima la corriente en ~41% (factor √2)."
            "</span>"
        )
        math_box.setWordWrap(True)
        math_box.setStyleSheet(
            f"background:{C_PANEL};border:1px solid {C_BORDER};"
            "border-radius:6px;padding:10px;")
        main.addWidget(math_box)

        self.fig_rms = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_rms  = FigureCanvas(self.fig_rms)
        self.cv_rms.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        gs_rms = gridspec.GridSpec(1, 2, figure=self.fig_rms, wspace=0.35)

        self.ax_rms_hist = self.fig_rms.add_subplot(gs_rms[0])
        _estilizar_ax(self.ax_rms_hist, "Historial True RMS Corriente", "mA (RMS)", C_CORR)
        self.line_rms_hist, = self.ax_rms_hist.plot([], [], color=C_CORR, lw=1.5, label='True RMS')
        self.line_rms_peak, = self.ax_rms_hist.plot([], [], color=C_CORR_RAW, lw=1.0,
                                                     ls='--', alpha=0.7, label='Pico crudo')
        self.ax_rms_hist.set_xlim(0, self.MAX_DATOS - 1)
        self.ax_rms_hist.set_ylim(0, self.LIM_CORR * 1.5)
        self.ax_rms_hist.legend(fontsize=7, facecolor='#0A1020',
                                edgecolor=C_BORDER, labelcolor='white')

        self.ax_rms_bar = self.fig_rms.add_subplot(gs_rms[1])
        self.ax_rms_bar.set_facecolor(C_AX_BG)
        self.ax_rms_bar.set_title("RMS vs Pico actual", color='#AACCFF', fontsize=9, fontweight='bold')
        self.ax_rms_bar.tick_params(colors='#6688AA', labelsize=8)
        for s in self.ax_rms_bar.spines.values(): s.set_edgecolor(C_BORDER)
        self.bars_rms = self.ax_rms_bar.bar(['True RMS', 'Pico Crudo'], [0, 0],
                                             color=[C_CORR, C_CORR_RAW], width=0.5,
                                             edgecolor=C_BORDER)
        self.ax_rms_bar.set_ylim(0, self.LIM_CORR * 1.5)
        self.ax_rms_bar.set_ylabel("mA", color='#8899BB', fontsize=8)
        self.txt_rms_factor = self.ax_rms_bar.text(
            0.5, 0.95, "Factor Pico/RMS: —",
            transform=self.ax_rms_bar.transAxes,
            ha='center', color='#FFD700', fontsize=8
        )

        main.addWidget(self.cv_rms)
        w.setLayout(main); return w

    # ── Sub-tab FFT ───────────────────────────────────────────────────────────
    def _tab_fft(self):
        w = QWidget(); main = QVBoxLayout(); main.setSpacing(6)

        # Panel de datos en vivo — FFT
        self.panel_datos_fft = PanelDatosVivo([
            ('v_proc',  'VIB (EMA)', 'u.a', C_VIB),
            ('bin_dom', 'BIN DOM',  '',    '#FF88AA'),
            ('rpm',     'RPM',      'rpm', '#AA88FF'),
        ])
        main.addWidget(self.panel_datos_fft)

        math_box = QLabel(
            "<b style='color:#FFD700;font-size:10pt;'>FFT — Transformada Rápida de Fourier</b><br><br>"
            "<span style='color:#AADDFF;'>"
            "La FFT descompone la señal temporal en sus frecuencias.<br>"
            "El dsPIC calcula una FFT de 64 puntos con ventana Hanning.<br><br>"
            "<span style='color:#FFD700;font-family:Consolas;'>"
            "Resolución de frecuencia: Δf = Fs / N<br>"
            "Fs = (RPM × 16) / 60  [adaptativo]<br>"
            "Bin dominante → frecuencia de vibración principal</span><br><br>"
            "La ventana Hanning reduce el 'spectral leakage' (fuga espectral):<br>"
            "sin ventana los picos se 'derraman' hacia bins vecinos.<br>"
            "Con Hanning: picos más limpios, mejor identificación de fallas."
            "</span>"
        )
        math_box.setWordWrap(True)
        math_box.setStyleSheet(
            f"background:{C_PANEL};border:1px solid {C_BORDER};"
            "border-radius:6px;padding:10px;")
        main.addWidget(math_box)

        self.fig_fft_d = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_fft_d  = FigureCanvas(self.fig_fft_d)
        self.cv_fft_d.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        gs_fft = gridspec.GridSpec(1, 2, figure=self.fig_fft_d, wspace=0.35)

        self.ax_fft_bars = self.fig_fft_d.add_subplot(gs_fft[0])
        self.ax_fft_bars.set_facecolor(C_AX_BG)
        self.ax_fft_bars.set_title("Espectro de Amplitud (último ciclo)", color='#AACCFF', fontsize=9, fontweight='bold')
        self.ax_fft_bars.tick_params(colors='#6688AA', labelsize=7)
        self.ax_fft_bars.set_xlabel("Bin de Frecuencia", color=C_TEXT_DIM, fontsize=7)
        self.ax_fft_bars.set_ylabel("Amplitud", color='#AA88FF', fontsize=8)
        for s in self.ax_fft_bars.spines.values(): s.set_edgecolor(C_BORDER)
        self.bar_fft = self.ax_fft_bars.bar(range(32), self.fft_bins,
                                             color='#AA88FF', edgecolor='none', width=0.8)
        self.ax_fft_bars.set_xlim(-0.5, 31.5)
        self.ax_fft_bars.set_ylim(0, self.LIM_VIB)

        self.ax_fft_cascade = self.fig_fft_d.add_subplot(gs_fft[1])
        self.ax_fft_cascade.set_facecolor('black')
        self.ax_fft_cascade.set_title("Cascada FFT Histórica", color='#AACCFF', fontsize=9, fontweight='bold')
        self.ax_fft_cascade.tick_params(colors='#6688AA', labelsize=7)
        for s in self.ax_fft_cascade.spines.values(): s.set_edgecolor(C_BORDER)
        self.img_fft_d = self.ax_fft_cascade.imshow(
            self.matriz_fft, aspect='auto', cmap='inferno', origin='lower',
            vmin=0, vmax=self.LIM_VIB/2, extent=[0, self.MAX_DATOS, 0, 31],
            interpolation='bilinear')

        main.addWidget(self.cv_fft_d)
        w.setLayout(main); return w

    # ── Sub-tab Pasa-Bajas (RPM) ──────────────────────────────────────────────
    def _tab_pasabaja(self):
        w = QWidget(); main = QVBoxLayout(); main.setSpacing(6)

        # Panel de datos en vivo — RPM
        self.panel_datos_rpm = PanelDatosVivo([
            ('rpm',     'RPM MEDIDA', 'rpm', '#AA88FF'),
            ('rpm_obj', 'RPM OBJETIVO', 'rpm', '#FFD700'),
        ])
        main.addWidget(self.panel_datos_rpm)

        math_box = QLabel(
            "<b style='color:#FFD700;font-size:10pt;'>Filtro Pasa-Bajas — Detección de RPM</b><br><br>"
            "<span style='color:#AADDFF;'>"
            "El dsPIC detecta las RPM contando los picos de las escobillas del motor.<br>"
            "Para aislar esos picos del ruido usa un filtro pasa-altas digital:<br><br>"
            "<span style='color:#FFD700;font-family:Consolas;'>"
            "delta = ADC[n] − ADC[n-1]<br>"
            "hp_filtrado = (31130 × (hp_filtrado + delta)) >> 15<br>"
            "Si hp_filtrado > 750 → cuenta un pico de escobilla</span><br><br>"
            "El coeficiente 31130/32768 ≈ 0.95 da una frecuencia de corte de:<br>"
            "<span style='color:#00FFCC;font-family:Consolas;'>fc = Fs × (1 − 0.95) / (2π) ≈ Fs/125</span><br><br>"
            "Luego las RPM se calculan con:<br>"
            "<span style='color:#FFD700;font-family:Consolas;'>"
            "RPM = (picos × Fs × 60) / (N_muestras × N_delgas)</span>"
            "</span>"
        )
        math_box.setWordWrap(True)
        math_box.setStyleSheet(
            f"background:{C_PANEL};border:1px solid {C_BORDER};"
            "border-radius:6px;padding:10px;")
        main.addWidget(math_box)

        self.fig_rpm = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_rpm  = FigureCanvas(self.fig_rpm)
        self.cv_rpm.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        self.ax_rpm_hist = self.fig_rpm.add_subplot(111)
        _estilizar_ax(self.ax_rpm_hist, "RPM Medidas vs RPM Objetivo (Modbus reg[0])", "RPM", '#AA88FF')
        self.hist_rpm_med = [0.0] * self.MAX_DATOS
        self.hist_rpm_obj = [0.0] * self.MAX_DATOS
        self.line_rpm_med, = self.ax_rpm_hist.plot([], [], color='#AA88FF', lw=1.5, label='RPM medidas')
        self.line_rpm_obj, = self.ax_rpm_hist.plot([], [], color='#FFD700', lw=1.0,
                                                    ls='--', alpha=0.8, label='RPM objetivo')
        self.ax_rpm_hist.set_xlim(0, self.MAX_DATOS - 1)
        self.ax_rpm_hist.set_ylim(0, 12000)
        self.ax_rpm_hist.legend(fontsize=7, facecolor='#0A1020',
                                edgecolor=C_BORDER, labelcolor='white')
        main.addWidget(self.cv_rpm)
        w.setLayout(main); return w

    # ══════════════════════════════════════════════════════════════════════════
    # TAB 4 — VIDA ÚTIL / RUL
    # ══════════════════════════════════════════════════════════════════════════
    def _crear_tab_rul(self):
        w = QWidget()
        main = QVBoxLayout(); main.setSpacing(8); main.setContentsMargins(8,8,8,8)

        # ── Panel de datos de placa del motor ────────────────────────────────
        grp_placa = QGroupBox("Datos de Placa del Motor (Fabricante)")
        grp_placa.setStyleSheet(
            f"QGroupBox{{border:1px solid #2A5090;border-radius:6px;margin-top:10px;"
            f"font-weight:bold;color:#7AAFFF;font-size:9pt;}}"
            f"QGroupBox::title{{subcontrol-origin:margin;left:10px;padding:0 5px;}}"
        )
        grid_placa = QGridLayout(); grid_placa.setSpacing(8)

        campos_placa = [
            ("RPM nominales:",          "rpm_nom",   "1750",  "rpm",  0, 0),
            ("Corriente en vacío:",      "i_vacio",   "80",    "mA",   0, 2),
            ("Corriente nominal (carga):", "i_nom",   "300",   "mA",   1, 0),
            ("Corriente de bloqueo:",    "i_bloq",    "900",   "mA",   1, 2),
            ("Vibración sana nominal:",  "vib_nom",   "5",     "u.a.", 2, 0),
            ("Vida útil (fabricante):",  "vida_nom",  "17520", "h",    2, 2),
        ]

        self._inputs_placa = {}
        for label_txt, key, default, unit, row, col in campos_placa:
            lbl = QLabel(label_txt)
            lbl.setStyleSheet(f"color:{C_TEXT};font-size:9pt;")
            inp = QLineEdit(default)
            inp.setFixedWidth(90)
            inp.setStyleSheet(
                f"background:#0D1525;border:1px solid {C_BORDER};"
                "border-radius:4px;padding:3px 6px;color:#FFD700;font-family:Consolas;")
            lbl_u = QLabel(unit)
            lbl_u.setStyleSheet(f"color:{C_TEXT_DIM};font-size:8pt;")
            grid_placa.addWidget(lbl,   row, col)
            grid_placa.addWidget(inp,   row, col+1)
            grid_placa.addWidget(lbl_u, row, col+1)   # se superpone — mejor en col+2... corregido:
            self._inputs_placa[key] = inp

        # Re-layout correcto con unidades en columna separada
        for i in reversed(range(grid_placa.count())):
            grid_placa.takeAt(i)

        col_labels = [0, 4]
        r = 0
        for idx, (label_txt, key, default, unit, row, col) in enumerate(campos_placa):
            c_off = 0 if col == 0 else 4
            lbl = QLabel(label_txt)
            lbl.setStyleSheet(f"color:{C_TEXT};font-size:9pt;")
            lbl_u = QLabel(unit)
            lbl_u.setStyleSheet(f"color:{C_TEXT_DIM};font-size:8pt;min-width:28px;")
            grid_placa.addWidget(lbl,                        row, c_off)
            grid_placa.addWidget(self._inputs_placa[key],    row, c_off+1)
            grid_placa.addWidget(lbl_u,                      row, c_off+2)

        self.btn_confirmar_placa = QPushButton("✔  Confirmar datos de placa y activar RUL")
        self.btn_confirmar_placa.setStyleSheet(
            "QPushButton{background:#002244;color:#00BFFF;border:1px solid #0055AA;"
            "border-radius:5px;font-weight:bold;padding:6px 18px;font-size:9pt;}"
            "QPushButton:hover{background:#003366;}"
        )
        self.btn_confirmar_placa.clicked.connect(self._confirmar_placa)
        grid_placa.addWidget(self.btn_confirmar_placa, 3, 0, 1, 7)
        grp_placa.setLayout(grid_placa)
        main.addWidget(grp_placa)

        # ── Panel de resultado RUL ────────────────────────────────────────────
        grp_rul = QGroupBox("Pronóstico de Vida Útil Restante")
        grp_rul.setStyleSheet(
            f"QGroupBox{{border:1px solid #2A5090;border-radius:6px;margin-top:10px;"
            f"font-weight:bold;color:#7AAFFF;font-size:9pt;}}"
            f"QGroupBox::title{{subcontrol-origin:margin;left:10px;padding:0 5px;}}"
        )
        rul_row = QHBoxLayout(); rul_row.setSpacing(20)

        self.lbl_rul_valor = QLabel("—")
        self.lbl_rul_valor.setFont(QFont("Consolas", 38, QFont.Bold))
        self.lbl_rul_valor.setStyleSheet("color:#00FFCC;background:transparent;")
        self.lbl_rul_valor.setAlignment(Qt.AlignCenter)

        self.lbl_rul_unidad = QLabel("horas restantes")
        self.lbl_rul_unidad.setFont(QFont("Consolas", 11))
        self.lbl_rul_unidad.setStyleSheet(f"color:{C_TEXT_DIM};background:transparent;")
        self.lbl_rul_unidad.setAlignment(Qt.AlignCenter)

        self.lbl_rul_conf = QLabel("Intervalo de confianza: ±—")
        self.lbl_rul_conf.setFont(QFont("Consolas", 9))
        self.lbl_rul_conf.setStyleSheet("color:#FFD700;background:transparent;")
        self.lbl_rul_conf.setAlignment(Qt.AlignCenter)

        self.lbl_rul_di = QLabel("DI actual: —  |  Umbral falla: 3.0σ")
        self.lbl_rul_di.setFont(QFont("Consolas", 9))
        self.lbl_rul_di.setStyleSheet(f"color:{C_TEXT_DIM};background:transparent;")
        self.lbl_rul_di.setAlignment(Qt.AlignCenter)

        self.lbl_rul_estado = QLabel("⏸  Esperando datos de placa")
        self.lbl_rul_estado.setFont(QFont("Consolas", 10, QFont.Bold))
        self.lbl_rul_estado.setStyleSheet(
            f"background:{C_PANEL};color:#556688;"
            f"border:1px solid {C_BORDER};border-radius:4px;padding:4px;")
        self.lbl_rul_estado.setAlignment(Qt.AlignCenter)

        col_num = QVBoxLayout()
        col_num.addWidget(self.lbl_rul_valor)
        col_num.addWidget(self.lbl_rul_unidad)
        col_num.addWidget(self.lbl_rul_conf)
        col_num.addWidget(self.lbl_rul_di)
        col_num.addWidget(self.lbl_rul_estado)

        rul_row.addLayout(col_num, stretch=1)
        grp_rul.setLayout(rul_row)
        main.addWidget(grp_rul)

        # ── Gráfico DI histórico + proyección RUL ────────────────────────────
        self.fig_rul = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_rul  = FigureCanvas(self.fig_rul)
        self.cv_rul.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        gs_rul = gridspec.GridSpec(1, 2, figure=self.fig_rul, wspace=0.35)

        # Subplot izq — DI en el tiempo
        self.ax_di = self.fig_rul.add_subplot(gs_rul[0])
        _estilizar_ax(self.ax_di, "Índice de Degradación (DI) — Historial", "DI [σ]", '#FF8C00')
        self.line_di,   = self.ax_di.plot([], [], color='#FF8C00', lw=1.5, label='DI actual')
        self.line_di_ma,= self.ax_di.plot([], [], color='#FFD700', lw=1.0,
                                           ls='--', alpha=0.8, label='DI media móvil (20)')
        self.ax_di.axhline(self._di_umbral, color=C_ALARM, ls='--', lw=1.0,
                           alpha=0.8, label=f'Umbral falla ({self._di_umbral}σ)')
        self.ax_di.set_xlim(0, 100)
        self.ax_di.set_ylim(0, self._di_umbral * 1.5)
        self.ax_di.legend(fontsize=7, facecolor='#0A1020',
                          edgecolor=C_BORDER, labelcolor='white')

        # Subplot der — Proyección RUL
        self.ax_rul_proj = self.fig_rul.add_subplot(gs_rul[1])
        _estilizar_ax(self.ax_rul_proj, "Proyección RUL (regresión lineal)", "DI [σ]", '#00FFCC')
        self.line_rul_hist, = self.ax_rul_proj.plot([], [], color='#00FFCC', lw=1.5,
                                                     label='DI histórico')
        self.line_rul_pred, = self.ax_rul_proj.plot([], [], color='#FF4488', lw=1.5,
                                                     ls='--', label='Proyección')
        self.fill_rul_ci    = None   # relleno de intervalo de confianza
        self.ax_rul_proj.axhline(self._di_umbral, color=C_ALARM, ls='--', lw=1.0, alpha=0.8)
        self.ax_rul_proj.set_xlim(0, 200)
        self.ax_rul_proj.set_ylim(0, self._di_umbral * 1.5)
        self.ax_rul_proj.set_xlabel("Muestras (pasadas → futuras)", color=C_TEXT_DIM, fontsize=7)
        self.ax_rul_proj.legend(fontsize=7, facecolor='#0A1020',
                                edgecolor=C_BORDER, labelcolor='white')

        main.addWidget(self.cv_rul)

        # ── Sección de Mantenimiento Preventivo ───────────────────────────────
        grp_mant = QGroupBox("Plan de Mantenimiento Preventivo (ISO 10816 / NEMA MG1 / IEC 60034)")
        grp_mant.setStyleSheet(
            f"QGroupBox{{border:1px solid #2A5090;border-radius:6px;margin-top:6px;"
            f"font-weight:bold;color:#7AAFFF;font-size:9pt;}}"
            f"QGroupBox::title{{subcontrol-origin:margin;left:10px;padding:0 5px;}}"
        )
        grid_mant = QGridLayout(); grid_mant.setSpacing(6)

        # Encabezados
        for col, txt, color in [(0,"Componente","#AACCFF"),(1,"Intervalo base","#AACCFF"),
                                 (2,"Próxima intervención","#AACCFF"),(3,"Estado","#AACCFF")]:
            lh = QLabel(txt)
            lh.setStyleSheet(f"color:{color};font-weight:bold;font-size:8pt;background:transparent;")
            grid_mant.addWidget(lh, 0, col)

        COMP_INFO = [
            ('rodamientos', 'Rodamientos',      '4 000 h',  'Reemplazar rodamientos — ISO 281 vida L10'),
            ('lubricacion', 'Lubricación',       '2 000 h',  'Regreasa rodamientos — NEMA MG1 §14.8'),
            ('escobillas',  'Escobillas / coll.','1 000 h',  'Inspección desgaste — NEMA MG1 §3.15'),
            ('aislamiento', 'Aislamiento bobina','8 760 h',  'Megger test ≥ 1MΩ/kV — IEEE 43-2013'),
            ('limpieza',    'Limpieza interna',  '  500 h',  'Soplado polvo, revisión ventilación'),
            ('correas',     'Correas / transm.', '3 000 h',  'Tensión y desgaste — ISO 22433'),
        ]

        self.tabla_mant_labels = {}
        for r, (key, nombre, intervalo, nota) in enumerate(COMP_INFO, start=1):
            lbl_n = QLabel(nombre)
            lbl_n.setStyleSheet(f"color:{C_TEXT};font-size:9pt;background:transparent;")
            lbl_n.setToolTip(nota)

            lbl_i = QLabel(intervalo)
            lbl_i.setStyleSheet(f"color:{C_TEXT_DIM};font-family:Consolas;font-size:9pt;background:transparent;")

            lbl_prox   = QLabel("— h")
            lbl_prox.setStyleSheet(f"color:#556688;font-family:Consolas;font-size:10pt;background:transparent;")
            lbl_estado = QLabel("⏸ Inactivo")
            lbl_estado.setStyleSheet(f"color:#556688;font-family:Consolas;font-size:9pt;background:transparent;")

            grid_mant.addWidget(lbl_n,      r, 0)
            grid_mant.addWidget(lbl_i,      r, 1)
            grid_mant.addWidget(lbl_prox,   r, 2)
            grid_mant.addWidget(lbl_estado, r, 3)
            self.tabla_mant_labels[key] = (lbl_prox, lbl_estado)

        # Fila de contadores
        lbl_cnt = QLabel()
        lbl_cnt.setStyleSheet(f"color:{C_TEXT_DIM};font-size:8pt;background:transparent;")
        lbl_cnt.setText("Sobrecargas acum.: 0  |  Desbalances acum.: 0  |  Horas operación: 0.0 h")
        self.lbl_contadores = lbl_cnt
        grid_mant.addWidget(lbl_cnt, len(COMP_INFO)+1, 0, 1, 4)

        grp_mant.setLayout(grid_mant)
        main.addWidget(grp_mant)

        # ── Sección de Historial de Eventos / Diagnóstico ─────────────────────
        grp_diag = QGroupBox("Historial de Eventos y Diagnóstico Diferencial")
        grp_diag.setStyleSheet(
            f"QGroupBox{{border:1px solid #2A5090;border-radius:6px;margin-top:6px;"
            f"font-weight:bold;color:#7AAFFF;font-size:9pt;}}"
            f"QGroupBox::title{{subcontrol-origin:margin;left:10px;padding:0 5px;}}"
        )
        diag_lay = QVBoxLayout()

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFixedHeight(180)
        scroll.setStyleSheet(
            f"background:{C_AX_BG};border:1px solid {C_BORDER};border-radius:4px;")

        self.lbl_historial = QLabel("  Sin eventos registrados")
        self.lbl_historial.setWordWrap(True)
        self.lbl_historial.setAlignment(Qt.AlignTop | Qt.AlignLeft)
        self.lbl_historial.setFont(QFont("Consolas", 8))
        self.lbl_historial.setStyleSheet(
            f"color:{C_TEXT};background:{C_AX_BG};padding:8px;border:none;")
        scroll.setWidget(self.lbl_historial)
        diag_lay.addWidget(scroll)
        grp_diag.setLayout(diag_lay)
        main.addWidget(grp_diag)

        w.setLayout(main)
        return w

    def _confirmar_placa(self):
        """Lee los campos de placa, valida y activa el motor RUL."""
        try:
            p = {}
            for key, inp in self._inputs_placa.items():
                val = float(inp.text().replace(',', '.'))
                if val <= 0:
                    raise ValueError(f"{key} debe ser > 0")
                p[key] = val

            # Validaciones de coherencia
            if p['i_vacio'] >= p['i_nom']:
                raise ValueError("Corriente vacío debe ser < corriente nominal")
            if p['i_nom'] >= p['i_bloq']:
                raise ValueError("Corriente nominal debe ser < corriente de bloqueo")

            self._placa = p
            self._placa_cargada = True

            # Vector de referencia sano normalizado:
            # [c_norm, v_norm, rpm_norm]  cada uno en fracción de su nominal
            self._ref_sano = np.array([
                p['i_nom']   / p['i_bloq'],   # corriente nominal / bloqueo
                p['vib_nom'] / 50.0,           # vibración nominal / límite HMI
                p['rpm_nom'] / 10000.0,        # rpm nominal / máximo HMI
            ])
            # Desviación estándar del estado sano: 5% de cada componente
            self._std_sano = self._ref_sano * 0.05 + 1e-6

            # Limpiar historial anterior
            self._hist_di.clear()
            self._hist_di_t.clear()
            self._muestra_global = 0
            self._rul_activo = True

            self.lbl_rul_estado.setText("✅  Placa confirmada — RUL activo, acumulando historial...")
            self.lbl_rul_estado.setStyleSheet(
                "background:#001A00;color:#00FF66;"
                f"border:1px solid #00AA33;border-radius:4px;padding:4px;")
            self.btn_confirmar_placa.setText("✔  Datos confirmados (click para re-calibrar)")

        except ValueError as e:
            self.lbl_rul_estado.setText(f"⚠  Error: {e}")
            self.lbl_rul_estado.setStyleSheet(
                "background:#2A0000;color:#FF4444;"
                f"border:1px solid red;border-radius:4px;padding:4px;")

    def _calcular_rul(self, c_proc, v_proc, rpm_val):
        """Calcula DI y RUL. Llama desde _datos solo si _rul_activo."""
        if not self._placa_cargada or self._ref_sano is None:
            return

        p = self._placa

        # ── 1. Vector de señal actual normalizado ────────────────────────────
        x = np.array([
            c_proc  / max(p['i_bloq'], 1.0),
            v_proc  / 50.0,
            rpm_val / 10000.0,
        ])

        # ── 2. Degradation Index: distancia normalizada al estado sano ───────
        diff = (x - self._ref_sano) / self._std_sano
        di   = float(np.sqrt(np.dot(diff, diff)))   # norma euclídea en espacio σ

        self._hist_di.append(di)
        self._hist_di_t.append(self._muestra_global)
        self._muestra_global += 1

        # Mantener solo los últimos _MAX_HIST_RUL
        if len(self._hist_di) > self._MAX_HIST_RUL:
            self._hist_di.pop(0)
            self._hist_di_t.pop(0)

        n = len(self._hist_di)

        # ── 3. Media móvil (20 muestras) para suavizar DI ────────────────────
        ventana_ma = min(20, n)
        di_ma      = np.convolve(self._hist_di, np.ones(ventana_ma)/ventana_ma, mode='valid')

        # ── 4. Regresión lineal sobre el DI suavizado → pendiente de degradación
        if n >= 30:
            t_arr  = np.array(self._hist_di_t[-len(di_ma):], dtype=float)
            di_arr = np.array(di_ma, dtype=float)

            # Regresión: DI(t) = a·t + b
            A      = np.vstack([t_arr, np.ones(len(t_arr))]).T
            result = np.linalg.lstsq(A, di_arr, rcond=None)
            a, b   = result[0]

            residuos = di_arr - (a * t_arr + b)
            std_res  = float(np.std(residuos)) if len(residuos) > 2 else 0.1

            if a > 1e-6:
                # Muestras hasta cruzar el umbral
                t_falla     = (self._di_umbral - b) / a
                muestras_rul = max(0.0, t_falla - self._muestra_global)

                # Convertir muestras a horas (500 ms por ciclo)
                horas_rul    = muestras_rul * 0.5 / 3600.0

                # Intervalo de confianza ±1σ en horas
                if a > 1e-6:
                    delta_t  = std_res / a
                    horas_ci = delta_t * 0.5 / 3600.0
                else:
                    horas_ci = 0.0

                self._rul_horas     = horas_rul
                self._rul_std_horas = horas_ci

                # ── Actualizar gráfico de proyección ─────────────────────────
                try:
                    n_proj   = min(int(muestras_rul * 1.2) + 10, 2000)
                    t_fut    = np.arange(self._muestra_global,
                                         self._muestra_global + n_proj)
                    di_fut   = a * t_fut + b
                    di_fut_u = di_fut + std_res
                    di_fut_l = np.maximum(0, di_fut - std_res)

                    t_hist_plot = np.array(self._hist_di_t, dtype=float)
                    di_hist_arr = np.array(self._hist_di, dtype=float)

                    # Normalizar x al rango [0, len_hist + n_proj]
                    t0  = t_hist_plot[0]
                    th  = t_hist_plot - t0
                    tf  = t_fut       - t0

                    self.line_rul_hist.set_data(th, di_hist_arr)
                    self.line_rul_pred.set_data(tf, di_fut)

                    if self.fill_rul_ci is not None:
                        self.fill_rul_ci.remove()
                    self.fill_rul_ci = self.ax_rul_proj.fill_between(
                        tf, di_fut_l, di_fut_u,
                        color='#FF4488', alpha=0.15, label='±1σ confianza'
                    )

                    x_max = max(float(th[-1]), float(tf[-1])) * 1.05
                    self.ax_rul_proj.set_xlim(0, max(x_max, 50))
                    self.ax_rul_proj.set_ylim(0, self._di_umbral * 1.6)
                    self.cv_rul.draw_idle()
                except Exception:
                    pass

            else:
                # Pendiente negativa o plana → motor mejorando o estable
                self._rul_horas     = p['vida_nom']
                self._rul_std_horas = p['vida_nom'] * 0.1
        else:
            self._rul_horas     = None
            self._rul_std_horas = None

        # ── 5. Actualizar gráfico DI histórico ───────────────────────────────
        t_arr_full = np.array(self._hist_di_t, dtype=float) - self._hist_di_t[0]
        di_arr_full = np.array(self._hist_di, dtype=float)
        self.line_di.set_data(t_arr_full, di_arr_full)

        if len(di_ma) > 0:
            offset_ma = len(self._hist_di) - len(di_ma)
            t_ma      = t_arr_full[offset_ma:]
            self.line_di_ma.set_data(t_ma, di_ma)

        self.ax_di.set_xlim(0, max(float(t_arr_full[-1]) * 1.1, 50))
        self.ax_di.set_ylim(0, max(self._di_umbral * 1.5, float(np.max(di_arr_full)) * 1.2))
        self.cv_rul.draw_idle()

        # ── 6. Actualizar labels numéricos ───────────────────────────────────
        self.lbl_rul_di.setText(
            f"DI actual: {di:.3f}σ  |  Media móvil: {float(di_ma[-1]):.3f}σ  |  Umbral falla: {self._di_umbral}σ"
            if len(di_ma) > 0 else f"DI actual: {di:.3f}σ  |  Umbral: {self._di_umbral}σ"
        )

        if self._rul_horas is not None:
            h = self._rul_horas
            ci = self._rul_std_horas or 0.0
            dias   = int(h // 24)
            horas  = int(h % 24)

            if h > p['vida_nom'] * 0.5:
                color_rul = '#00FFCC'
                estado    = "✅  MOTOR EN BUEN ESTADO"
                bg_estado = '#001A00'; border_estado = '#00AA33'
            elif h > p['vida_nom'] * 0.2:
                color_rul = '#FFD700'
                estado    = "⚠  DEGRADACIÓN DETECTADA — Planificar mantenimiento"
                bg_estado = '#1A1000'; border_estado = '#886600'
            elif h > 0:
                color_rul = '#FF4444'
                estado    = "⛔  FALLA PRÓXIMA — Mantenimiento urgente"
                bg_estado = '#2A0000'; border_estado = 'red'
            else:
                color_rul = '#FF0000'
                estado    = "🔴  VIDA ÚTIL AGOTADA"
                bg_estado = '#330000'; border_estado = 'darkred'

            self.lbl_rul_valor.setText(f"{h:,.0f}")
            self.lbl_rul_valor.setStyleSheet(f"color:{color_rul};background:transparent;")
            self.lbl_rul_conf.setText(f"Intervalo de confianza: ±{ci:,.0f} h  ({dias}d {horas}h restantes)")
            self.lbl_rul_estado.setText(estado)
            self.lbl_rul_estado.setStyleSheet(
                f"background:{bg_estado};color:{color_rul};"
                f"border:1px solid {border_estado};border-radius:4px;padding:4px;")
        else:
            muestras_faltantes = max(0, 30 - n)
            self.lbl_rul_valor.setText("...")
            self.lbl_rul_valor.setStyleSheet(f"color:#556688;background:transparent;")
            self.lbl_rul_estado.setText(
                f"⟳  Acumulando historial — faltan ~{muestras_faltantes} muestras (≈{muestras_faltantes//2}s)")
            self.lbl_rul_estado.setStyleSheet(
                f"background:{C_PANEL};color:#00BFFF;"
                f"border:1px solid #004488;border-radius:4px;padding:4px;")

        # ── Actualizar contador global de la tabla ────────────────────────────
        try:
            self.lbl_contadores.setText(
                f"Sobrecargas acum.: {self._sobrecarga_count}  |  "
                f"Desbalances acum.: {self._desbalance_count}  |  "
                f"Horas operación: {self._horas_acum:.1f} h  |  "
                f"Total eventos: {self._sobrecarga_count + self._desbalance_count}"
            )
            self._actualizar_tabla_mant()
        except Exception:
            pass

        # ══════════════════════════════════════════════════════════════════════════
    # TAB 5 — HISTORIAL, FIRMA DE ARRANQUE Y TENDENCIA ENTRE SESIONES
    # ══════════════════════════════════════════════════════════════════════════
    def _crear_tab_historico(self):
        w    = QWidget()
        main = QVBoxLayout(); main.setSpacing(6); main.setContentsMargins(6,6,6,6)

        # ── Fila superior: firma de arranque + similitud ──────────────────────
        fila1 = QHBoxLayout(); fila1.setSpacing(8)

        # Panel firma
        grp_firma = QGroupBox("Firma de Arranque — Transitorio (IEEE 1099 MCSA)")
        grp_firma.setStyleSheet(
            f"QGroupBox{{border:1px solid #2A5090;border-radius:6px;margin-top:8px;"
            "font-weight:bold;color:#7AAFFF;font-size:9pt;}}"
            "QGroupBox::title{subcontrol-origin:margin;left:10px;padding:0 5px;}"
        )
        firma_lay = QVBoxLayout()

        self.lbl_firma_sim = QLabel("Similitud con motor sano: —")
        self.lbl_firma_sim.setFont(QFont("Consolas", 20, QFont.Bold))
        self.lbl_firma_sim.setStyleSheet("color:#00FFCC;background:transparent;")
        self.lbl_firma_sim.setAlignment(Qt.AlignCenter)

        self.lbl_firma_detalle = QLabel(
            "RPM pico: —  |  I pico: —  |  T estab.: —"
            "Capturando firma de arranque (primeros 6s)...")
        self.lbl_firma_detalle.setFont(QFont("Consolas", 8))
        self.lbl_firma_detalle.setStyleSheet(f"color:{C_TEXT_DIM};background:transparent;")
        self.lbl_firma_detalle.setAlignment(Qt.AlignCenter)

        firma_lay.addWidget(self.lbl_firma_sim)
        firma_lay.addWidget(self.lbl_firma_detalle)

        # Mini gráfico de la firma
        self.fig_firma = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_firma  = FigureCanvas(self.fig_firma)
        self.cv_firma.setFixedHeight(130)
        gs_f = gridspec.GridSpec(2, 1, figure=self.fig_firma, hspace=0.15)
        self.ax_firma_c = self.fig_firma.add_subplot(gs_f[0])
        self.ax_firma_v = self.fig_firma.add_subplot(gs_f[1])
        for ax, col, lbl in [(self.ax_firma_c, C_CORR, 'I [mA]'),
                              (self.ax_firma_v, C_VIB,  'Vib')]:
            ax.set_facecolor(C_AX_BG)
            ax.tick_params(colors='#6688AA', labelsize=6)
            ax.set_ylabel(lbl, color=col, fontsize=7)
            for s in ax.spines.values(): s.set_edgecolor(C_BORDER)
            ax.grid(True, color=C_GRID, ls='--', lw=0.4, alpha=0.7)
        self.line_firma_c, = self.ax_firma_c.plot([], [], color=C_CORR, lw=1.5)
        self.line_firma_v, = self.ax_firma_v.plot([], [], color=C_VIB,  lw=1.5)
        # Línea de referencia (firma sana)
        self.line_firma_c_ref, = self.ax_firma_c.plot([], [], color='#FFD700', lw=1.0, ls='--', alpha=0.7, label='Ref sana')
        self.line_firma_v_ref, = self.ax_firma_v.plot([], [], color='#FFD700', lw=1.0, ls='--', alpha=0.7)

        firma_lay.addWidget(self.cv_firma)
        grp_firma.setLayout(firma_lay)
        fila1.addWidget(grp_firma, stretch=2)

        # Panel tendencia actual
        grp_tend = QGroupBox("Alerta Temprana — Tendencia entre Sesiones")
        grp_tend.setStyleSheet(
            f"QGroupBox{{border:1px solid #2A5090;border-radius:6px;margin-top:8px;"
            "font-weight:bold;color:#7AAFFF;font-size:9pt;}}"
            "QGroupBox::title{subcontrol-origin:margin;left:10px;padding:0 5px;}"
        )
        tend_lay = QVBoxLayout()

        self.lbl_tendencia = QLabel("⏸  Sin historial suficiente (mín. 5 sesiones)")
        self.lbl_tendencia.setFont(QFont("Consolas", 9, QFont.Bold))
        self.lbl_tendencia.setWordWrap(True)
        self.lbl_tendencia.setStyleSheet(
            f"background:{C_PANEL};color:#556688;"
            f"border:1px solid {C_BORDER};border-radius:4px;padding:6px;")

        self.lbl_tend_detalle = QLabel("Pendiente DI: —  |  R²: —  |  Similitud actual: —")
        self.lbl_tend_detalle.setFont(QFont("Consolas", 8))
        self.lbl_tend_detalle.setStyleSheet(f"color:{C_TEXT_DIM};background:transparent;")

        tend_lay.addWidget(self.lbl_tendencia)
        tend_lay.addWidget(self.lbl_tend_detalle)

        # Mini gráfico tendencia DI histórico entre sesiones
        self.fig_tend = Figure(facecolor=C_BG, tight_layout=True)
        self.cv_tend  = FigureCanvas(self.fig_tend)
        self.cv_tend.setFixedHeight(130)
        self.ax_tend = self.fig_tend.add_subplot(111)
        _estilizar_ax(self.ax_tend, "DI medio por sesión", "DI [σ]", '#FF8C00')
        self.line_tend_di,  = self.ax_tend.plot([], [], color='#FF8C00', lw=1.5,
                                                  marker='o', markersize=3, label='DI sesión')
        self.line_tend_reg, = self.ax_tend.plot([], [], color='#FF4488', lw=1.0,
                                                  ls='--', alpha=0.8, label='Regresión')
        self.ax_tend.axhline(3.0, color=C_ALARM, ls='--', lw=0.8, alpha=0.7)
        self.ax_tend.set_xlim(0, 10); self.ax_tend.set_ylim(0, 4)
        self.ax_tend.legend(fontsize=6, facecolor='#0A1020',
                            edgecolor=C_BORDER, labelcolor='white')
        tend_lay.addWidget(self.cv_tend)
        grp_tend.setLayout(tend_lay)
        fila1.addWidget(grp_tend, stretch=3)

        main.addLayout(fila1)

        # ── Tabla de sesiones históricas ──────────────────────────────────────
        grp_hist = QGroupBox("Sesiones Anteriores (base de datos local)")
        grp_hist.setStyleSheet(
            f"QGroupBox{{border:1px solid #2A5090;border-radius:6px;margin-top:6px;"
            "font-weight:bold;color:#7AAFFF;font-size:9pt;}}"
            "QGroupBox::title{subcontrol-origin:margin;left:10px;padding:0 5px;}"
        )
        hist_lay = QVBoxLayout()

        # Encabezados
        enc_lay = QHBoxLayout()
        for txt, w in [("ID",40),("Inicio",150),("Horas",55),
                       ("DI med",60),("DI máx",60),
                       ("Sobrec.",55),("Desb.",55),("Similitud",75),("Sensor",120)]:
            lh = QLabel(txt)
            lh.setFixedWidth(w)
            lh.setFont(QFont("Consolas", 7, QFont.Bold))
            lh.setStyleSheet("color:#AACCFF;background:#0D1525;padding:2px;")
            lh.setAlignment(Qt.AlignCenter)
            enc_lay.addWidget(lh)
        enc_lay.addStretch()
        hist_lay.addLayout(enc_lay)

        scroll2 = QScrollArea()
        scroll2.setWidgetResizable(True)
        scroll2.setFixedHeight(160)
        scroll2.setStyleSheet(
            f"background:{C_AX_BG};border:1px solid {C_BORDER};border-radius:4px;")
        self._hist_container = QWidget()
        self._hist_container.setStyleSheet(f"background:{C_AX_BG};")
        self._hist_vlay = QVBoxLayout()
        self._hist_vlay.setSpacing(1)
        self._hist_vlay.setContentsMargins(0,0,0,0)
        self._hist_container.setLayout(self._hist_vlay)
        scroll2.setWidget(self._hist_container)
        hist_lay.addWidget(scroll2)

        # Botones
        btn_row = QHBoxLayout()
        self.btn_exportar = QPushButton("💾  Exportar a Excel")
        self.btn_exportar.setStyleSheet(
            "QPushButton{background:#002244;color:#00BFFF;border:1px solid #0055AA;"
            "border-radius:5px;font-weight:bold;padding:5px 14px;}"
            "QPushButton:hover{background:#003366;}")
        self.btn_exportar.clicked.connect(self._exportar_excel)

        self.btn_refrescar = QPushButton("🔄  Refrescar tabla")
        self.btn_refrescar.setStyleSheet(
            "QPushButton{background:#0F1830;color:#7AAFFF;border:1px solid #2A5090;"
            "border-radius:5px;font-weight:bold;padding:5px 14px;}"
            "QPushButton:hover{background:#142035;}")
        self.btn_refrescar.clicked.connect(self._refrescar_panel_historico)

        self.lbl_export_status = QLabel("")
        self.lbl_export_status.setFont(QFont("Consolas", 8))
        self.lbl_export_status.setStyleSheet(f"color:{C_TEXT_DIM};background:transparent;")

        btn_row.addWidget(self.btn_exportar)
        btn_row.addWidget(self.btn_refrescar)
        btn_row.addWidget(self.lbl_export_status)
        btn_row.addStretch()
        hist_lay.addLayout(btn_row)

        grp_hist.setLayout(hist_lay)
        main.addWidget(grp_hist)

        w.setLayout(main)
        # Cargar datos existentes
        self._refrescar_panel_historico()
        return w

    # ─────────────────────────────────────────────────────────────────────────
    def _actualizar_panel_firma(self, res: dict, sim: float | None):
        """Refresca el panel de firma de arranque con los resultados."""
        try:
            sim_txt = f"{sim:.1f} %" if sim is not None else "Sin ref."
            sim_col = ('#00FFCC' if sim and sim > 85 else
                       '#FFD700' if sim and sim > 65 else '#FF4444')
            self.lbl_firma_sim.setText(f"Similitud: {sim_txt}")
            self.lbl_firma_sim.setStyleSheet(f"color:{sim_col};background:transparent;font-size:20pt;font-weight:bold;")

            rpm_p = res.get('rpm_pico')  or 0
            c_p   = res.get('c_pico')    or 0
            t_e   = res.get('t_estab_s') or 0
            self.lbl_firma_detalle.setText(
                f"RPM pico: {rpm_p:.0f}  |  I pico: {c_p:.1f} mA  |  T estab.: {t_e:.1f} s"
            )

            # Graficar firma
            muestras = res.get('muestras', [])
            if muestras:
                ts = [m['t'] for m in muestras]
                cs = [m['c_proc'] for m in muestras]
                vs = [m['v_proc'] for m in muestras]
                self.line_firma_c.set_data(ts, cs)
                self.line_firma_v.set_data(ts, vs)
                self.ax_firma_c.set_xlim(min(ts), max(ts)+1)
                self.ax_firma_c.set_ylim(0, max(cs)*1.3 + 1)
                self.ax_firma_v.set_xlim(min(ts), max(ts)+1)
                self.ax_firma_v.set_ylim(0, max(vs)*1.3 + 1)

            # Graficar firma de referencia si existe
            if self._firma_ref_vec:
                n = len(muestras)
                placa = self._placa if self._placa_cargada else {}
                i_bloq = placa.get('i_bloq', 900.0)
                rpm_obj = float(self.input_rpm.text()) if self._firma else 100
                # Des-normalizar referencia para visualizar
                chunk = len(self._firma_ref_vec) // 3
                c_ref = np.array(self._firma_ref_vec[:chunk]) * i_bloq
                v_ref = np.array(self._firma_ref_vec[chunk:2*chunk]) * 50.0
                t_ref = list(range(len(c_ref)))
                self.line_firma_c_ref.set_data(t_ref[:n], c_ref[:n])
                self.line_firma_v_ref.set_data(t_ref[:n], v_ref[:n])

            self.cv_firma.draw_idle()
        except Exception as e:
            print(f"[_actualizar_panel_firma] {e}")

    # ─────────────────────────────────────────────────────────────────────────
    def _refrescar_panel_historico(self):
        """Recarga sesiones de BD y actualiza tabla + gráfico de tendencia."""
        try:
            sesiones = self._db.obtener_sesiones(30)

            # Limpiar tabla
            while self._hist_vlay.count():
                item = self._hist_vlay.takeAt(0)
                if item.widget():
                    item.widget().deleteLater()

            COLS = [("ID",40),("Inicio",150),("Horas",55),
                    ("DI med",60),("DI máx",60),
                    ("Sobrec.",55),("Desb.",55),("Similitud",75),("Sensor",120)]

            for s in sesiones:
                row_w = QWidget()
                row_w.setStyleSheet(f"background:#0D1525;border-bottom:1px solid {C_BORDER};")
                row_lay = QHBoxLayout(); row_lay.setContentsMargins(0,1,0,1); row_lay.setSpacing(0)

                sim  = s['similitud_pct']
                dim  = s['di_medio']  or 0
                dimx = s['di_max']    or 0
                sobr = s['sobrecargas'] or 0
                desb = s['desbalances'] or 0

                sim_col = ('#00FFCC' if sim and sim > 80 else
                           '#FFD700' if sim and sim > 60 else
                           '#FF4444' if sim else '#556688')
                di_col  = ('#00FFCC' if dim < 1.0 else
                           '#FFD700' if dim < 2.0 else '#FF4444')

                vals_cols = [
                    (str(s['id']),             40,  '#AACCFF'),
                    (s['inicio'] or '—',       150, C_TEXT),
                    (f"{s['horas_op'] or 0:.1f}h", 55, C_TEXT),
                    (f"{dim:.2f}σ" if dim else '—', 60, di_col),
                    (f"{dimx:.2f}σ" if dimx else '—',60,di_col),
                    (str(sobr),                55, '#FF4444' if sobr else C_TEXT),
                    (str(desb),                55, '#FFA500' if desb else C_TEXT),
                    (f"{sim:.0f}%" if sim else '—', 75, sim_col),
                    (s['sensor_tipo'] or '—',  120, C_TEXT_DIM),
                ]

                for txt, w, fg in vals_cols:
                    lbl = QLabel(txt)
                    lbl.setFixedWidth(w)
                    lbl.setFont(QFont("Consolas", 8))
                    lbl.setStyleSheet(f"color:{fg};background:transparent;padding:1px 3px;")
                    lbl.setAlignment(Qt.AlignCenter)
                    row_lay.addWidget(lbl)

                row_lay.addStretch()
                row_w.setLayout(row_lay)
                self._hist_vlay.addWidget(row_w)

            # Actualizar gráfico de tendencia
            tend = self._db.tendencia_di(30)
            if len(tend) >= 2:
                xs  = list(range(len(tend)))
                dis = [t['di_medio'] or 0 for t in tend]
                self.line_tend_di.set_data(xs, dis)
                # Línea de regresión
                xs_arr = np.array(xs, dtype=float)
                di_arr = np.array(dis, dtype=float)
                A = np.vstack([xs_arr, np.ones(len(xs_arr))]).T
                (a, b), _, _, _ = np.linalg.lstsq(A, di_arr, rcond=None)
                self.line_tend_reg.set_data(xs_arr, a*xs_arr + b)
                self.ax_tend.set_xlim(0, max(len(tend)-1, 5))
                self.ax_tend.set_ylim(0, max(max(dis)*1.3, 1.0))
                self.cv_tend.draw_idle()

                # Actualizar label de tendencia
                res_tend = self._tendencia.analizar()
                nivel    = res_tend['nivel']
                col_map  = {'ok':'#00FFCC','alerta':'#FFD700','critico':'#FF4444','sin_datos':'#556688'}
                bg_map   = {'ok':'#001A00','alerta':'#1A1000','critico':'#2A0000','sin_datos':C_PANEL}
                color    = col_map.get(nivel, '#556688')
                bg       = bg_map.get(nivel, C_PANEL)
                self.lbl_tendencia.setText(res_tend['mensaje'])
                self.lbl_tendencia.setStyleSheet(
                    f"background:{bg};color:{color};"
                    f"border:1px solid {color};border-radius:4px;padding:6px;")
                pend = res_tend.get('pendiente_di')
                r2   = res_tend.get('r2')
                sim_a= res_tend.get('sim_actual')
                self.lbl_tend_detalle.setText(
                    f"Pendiente DI: {pend:+.4f}σ/sesión  |  "
                    f"R²: {r2:.3f}  |  "
                    f"Similitud actual: {sim_a:.1f}%  |  "
                    f"Sesiones analizadas: {len(tend)}"
                    if pend is not None and r2 is not None and sim_a is not None
                    else f"Sesiones analizadas: {len(tend)}"
                )

        except Exception as e:
            print(f"[_refrescar_panel_historico] {e}")

    def _cargar_tendencia_bd(self):
        """Carga el historial de DI de BD al arrancar la app."""
        try:
            tend = self._db.tendencia_di(30)
            for t in tend:
                self._tendencia.agregar_sesion(
                    t['id'], t['di_medio'],
                    self._db.obtener_sesiones(1)[0].get('similitud_pct')
                    if self._db.obtener_sesiones(1) else None
                )
        except Exception:
            pass

    def _exportar_excel(self):
        """Exporta toda la BD a un Excel con formato."""
        try:
            ruta = self._db.exportar_excel()
            self.lbl_export_status.setText(f"✅  Guardado: {ruta}")
            self.lbl_export_status.setStyleSheet("color:#00FFCC;background:transparent;")
        except ImportError:
            self.lbl_export_status.setText("⚠  Instala openpyxl:  pip install openpyxl")
            self.lbl_export_status.setStyleSheet("color:#FFD700;background:transparent;")
        except Exception as e:
            self.lbl_export_status.setText(f"⚠  Error: {e}")
            self.lbl_export_status.setStyleSheet("color:#FF4444;background:transparent;")

        # ══════════════════════════════════════════════════════════════════════════
    # HELPERS: TIMER HORAS, REGISTRO DE EVENTOS, DIAGNÓSTICO
    # ══════════════════════════════════════════════════════════════════════════
    def _tick_horas(self):
        """Incrementa horas acumuladas y actualiza la tabla de mantenimiento."""
        self._horas_acum += 1.0
        if self._rul_activo:
            self._actualizar_tabla_mant()

    def _registrar_evento(self, tipo, d):
        """Guarda un evento de falla con diagnóstico diferencial."""
        evento = {
            'tipo'   : tipo,
            'hora_op': self._horas_acum,
            'c_proc' : d.get('c_proc', 0.0),
            'c_crud' : d.get('c_crud', 0.0),
            'v_proc' : d.get('v_proc', 0.0),
            'v_crud' : d.get('v_crud', 0.0),
            'rpm'    : d.get('rpm', 0),
            'bin_dom': d.get('bin_dom', 0),
            'diagnostico': self._diagnosticar_falla(tipo, d),
        }
        self._historial_eventos.append(evento)
        if len(self._historial_eventos) > 50:
            self._historial_eventos.pop(0)
        # Guardar en BD
        try:
            self._db.guardar_evento(tipo, self._horas_acum, d, evento['diagnostico'])
        except Exception:
            pass
        try:
            self._refrescar_tabla_eventos()
        except Exception:
            pass

    def _diagnosticar_falla(self, tipo, d):
        """
        Diagnóstico diferencial cruzando vibración + corriente + RPM.
        Referencias: IEEE 1099-2022, ISO 10816-3, NEMA MG1-2021 §12.
        Devuelve (causa_probable, norma_ref, accion_recomendada).
        """
        c  = d.get('c_proc', 0.0)
        cv = d.get('c_crud', 0.0)
        v  = d.get('v_proc', 0.0)
        r  = d.get('rpm', 0)
        b  = d.get('bin_dom', 0)
        p  = self._placa if self._placa_cargada else {}

        i_nom  = p.get('i_nom',  300.0)
        i_bloq = p.get('i_bloq', 900.0)
        r_nom  = p.get('rpm_nom', 1750.0)
        v_nom  = p.get('vib_nom', 5.0)

        # Ratios de diagnóstico
        ratio_i   = c  / max(i_nom,  1.0)   # >1.3 → sobrecarga eléctrica
        ratio_ip  = cv / max(i_nom,  1.0)   # >2.0 → pico de arranque / cortocircuito
        ratio_v   = v  / max(v_nom,  1.0)   # >3.0 → vibración severa ISO 10816
        ratio_rpm = r  / max(r_nom,  1.0)   # <0.9 → caída de velocidad bajo carga

        if tipo == 'SOBRECARGA':
            # ── Árbol de decisión IEEE 1099 / NEMA MG1 ────────────────────────
            if ratio_ip > 2.5 and ratio_v < 1.5:
                causa  = "Sobrecarga mecánica súbita (atascamiento)"
                norma  = "NEMA MG1-2021 §12.48 / IEEE 1099 §6.3.2"
                accion = "Verificar carga acoplada, correas o rodamientos bloqueados"
            elif ratio_i > 1.5 and ratio_v > 2.5:
                causa  = "Desbalance de carga + vibración excesiva"
                norma  = "ISO 10816-3 Zona D / IEEE 1099 §6.4"
                accion = "Balanceo dinámico urgente + inspección de rodamientos"
            elif ratio_i > 1.3 and ratio_rpm < 0.88:
                causa  = "Caída de tensión de alimentación o falla de fase"
                norma  = "NEMA MG1-2021 §12.45 / IEEE Std 1100"
                accion = "Verificar tensión de red, fusibles y borneras de conexión"
            elif ratio_i > 1.2 and ratio_v < 1.2 and ratio_rpm > 0.95:
                causa  = "Sobrecarga térmica por ciclo de trabajo excesivo"
                norma  = "IEC 60034-1 Clase de servicio S1→S3"
                accion = "Reducir ciclo de trabajo o mejorar ventilación"
            elif ratio_ip > 1.8 and ratio_rpm < 0.7:
                causa  = "Arranque con carga plena (corriente de bloqueo)"
                norma  = "NEMA MG1-2021 §12.38 — arranque directo"
                accion = "Implementar arrancador suave o variador de frecuencia"
            else:
                causa  = "Sobrecorriente transitoria — posible pico de red"
                norma  = "IEEE 1100-2005 §8.3 (power quality)"
                accion = "Instalar filtro EMI / supresor de transitorios en alimentación"

        else:  # DESBALANCE
            if ratio_v > 3.0 and b > 0:
                causa  = f"Desbalance mecánico severo (frecuencia bin {b})"
                norma  = "ISO 10816-3 Zona D — vibración inaceptable"
                accion = "Balanceo dinámico inmediato, inspección de rotor y acoplamiento"
            elif ratio_v > 2.0 and ratio_i > 1.1:
                causa  = "Excentricidad de rotor o desgaste de rodamiento"
                norma  = "ISO 10816-3 Zona C / IEEE 1099 §7.2.1"
                accion = "Análisis de firma de corriente (MCSA) + cambio de rodamientos"
            elif ratio_v > 1.5 and ratio_rpm > 1.05:
                causa  = "Resonancia mecánica — frecuencia natural excitada"
                norma  = "ISO 10816-1 §5.4 — análisis modal"
                accion = "Verificar rigidez de montaje y frecuencias de resonancia"
            elif ratio_v > 1.0 and ratio_i < 1.05 and ratio_rpm > 0.98:
                causa  = "Desalineación de acoplamiento (angular o paralela)"
                norma  = "ISO 10816-3 Zona B→C / NEMA MG1 §7.06"
                accion = "Realineación laser del acoplamiento motor-carga"
            else:
                causa  = "Vibración elevada sin patrón eléctrico claro"
                norma  = "ISO 10816-3 Zona B — monitoreo recomendado"
                accion = "Incrementar frecuencia de monitoreo; inspección visual"

        return {'causa': causa, 'norma': norma, 'accion': accion}

    def _actualizar_tabla_mant(self):
        """Recalcula próximas intervenciones con aceleración por DI."""
        if not hasattr(self, 'tabla_mant_labels'):
            return
        p   = self._placa if self._placa_cargada else {}
        di  = float(self._hist_di[-1]) if self._hist_di else 0.0
        di_ma = float(np.mean(self._hist_di[-20:])) if len(self._hist_di) >= 20 else di

        # Factor de aceleración: a mayor degradación, los intervalos se acortan
        # DI=0 → factor=1.0 (normal), DI=3 → factor=0.4 (40% del intervalo)
        factor_deg = max(0.3, 1.0 - (di_ma / self._di_umbral) * 0.6)

        # Factor adicional por sobrecargas acumuladas (cada 5 sobrecargas -10%)
        factor_sob = max(0.5, 1.0 - (self._sobrecarga_count // 5) * 0.10)
        factor     = factor_deg * factor_sob

        for nombre, (lbl_prox, lbl_estado) in self.tabla_mant_labels.items():
            intervalo_adj = self._INTERVALO_BASE[nombre] * factor
            horas_restantes = max(0.0, intervalo_adj - (self._horas_acum % intervalo_adj))
            pct = 1.0 - (horas_restantes / max(1, intervalo_adj))

            if pct > 0.90:
                color = '#FF3333'; estado_txt = "⛔ URGENTE"
            elif pct > 0.70:
                color = '#FFD700'; estado_txt = "⚠ PRÓXIMO"
            else:
                color = '#00FFCC'; estado_txt = "✅ OK"

            lbl_prox.setText(f"{horas_restantes:,.0f} h")
            lbl_prox.setStyleSheet(f"color:{color};font-family:Consolas;font-size:10pt;font-weight:bold;background:transparent;")
            lbl_estado.setText(estado_txt)
            lbl_estado.setStyleSheet(f"color:{color};font-family:Consolas;font-size:9pt;background:transparent;")

    def _refrescar_tabla_eventos(self):
        """Actualiza la QLabel de historial de eventos."""
        if not hasattr(self, 'lbl_historial'):
            return
        if not self._historial_eventos:
            self.lbl_historial.setText("  Sin eventos registrados")
            return
        lines = []
        for ev in reversed(self._historial_eventos[-8:]):  # últimos 8
            t   = ev['tipo']
            h   = ev['hora_op']
            d   = ev['diagnostico']
            c   = d['causa']
            n   = d['norma']
            a   = d['accion']
            col = '#FF4444' if t == 'SOBRECARGA' else '#FFA500'
            lines.append(
                f"<span style='color:{col};font-weight:bold;'>[{t}]</span>"
                f"<span style='color:#888;'> {h:.1f}h op.</span><br>"
                f"<span style='color:#CCDDFF;'>  ↳ {c}</span><br>"
                f"<span style='color:#556688;'>  📋 {n}</span><br>"
                f"<span style='color:#00FFCC;'>  🔧 {a}</span><br>"
            )
        self.lbl_historial.setText("<br>".join(lines))

        # ══════════════════════════════════════════════════════════════════════════
    # CONTROL: INICIAR / DETENER
    # ══════════════════════════════════════════════════════════════════════════
    def _iniciar(self):
        try:
            rpm = int(self.input_rpm.text())
            if not (10 <= rpm <= 10000): raise ValueError
            id_s = int(self.combo_sensor.currentText()[0])
            est_v = int(self.combo_vent.currentText()[0])

            self.hilo_trabajo = TrabajoModbus('/dev/ttyUSB0', rpm, id_s, est_v)
            self.hilo_trabajo.datos_listos.connect(self._datos)
            self.hilo_trabajo.start()

            self.btn_iniciar.setEnabled(False)
            self.btn_detener.setEnabled(True)
            self.combo_sensor.setEnabled(False)
            self.combo_vent.setEnabled(False)
            self.input_rpm.setEnabled(False)
            self._set_estado("⟳  Conectando al dsPIC...", '#00FFCC')
            self._horas_acum = 0.0
            self._historial_eventos.clear()
            self._sobrecarga_count = 0
            self._desbalance_count = 0
            self._di_sesion.clear()
            self._muestra_sesion  = 0
            self._similitud_sesion = None
            self._timer_horas.start(3600000)

            # Abrir sesión en BD
            sensor_txt = self.combo_sensor.currentText()
            placa_snap  = self._placa if self._placa_cargada else None
            self._db.abrir_sesion(rpm, sensor_txt, placa_snap)

            # Crear analizador de firma de arranque
            self._firma = AnalizadorFirma(rpm, self._placa if self._placa_cargada else None)

            # Cargar vector de referencia sano desde BD
            ref = self._db.obtener_firma_referencia()
            self._firma_ref_vec = ref['vector'] if ref else None

        except ValueError:
            self._set_estado("⚠  RPM inválido (10–10000)", '#FF4444',
                             bg='#2A0000', border='#FF2222')

    def _detener(self):
        if self.hilo_trabajo:
            self.hilo_trabajo.detener()
            self.hilo_trabajo.wait()
            self.hilo_trabajo = None
        self.btn_iniciar.setEnabled(True)
        self.btn_detener.setEnabled(False)
        self.combo_sensor.setEnabled(True)
        self.combo_vent.setEnabled(True)
        self.input_rpm.setEnabled(True)
        self._timer_horas.stop()
        # Cerrar sesión en BD con resumen
        di_arr   = self._di_sesion
        di_medio = float(np.mean(di_arr)) if di_arr else None
        di_max   = float(np.max(di_arr))  if di_arr else None
        self._db.cerrar_sesion(
            horas_op      = self._horas_acum,
            sobrecargas   = self._sobrecarga_count,
            desbalances   = self._desbalance_count,
            di_medio      = di_medio,
            di_max        = di_max,
            similitud_pct = self._similitud_sesion,
        )
        # Actualizar detector de tendencia
        if di_medio is not None:
            ultimas = self._db.obtener_sesiones(1)
            sid     = ultimas[0]['id'] if ultimas else 0
            self._tendencia.agregar_sesion(sid, di_medio, self._similitud_sesion)
        self._set_estado("■  MONITOREO DETENIDO", '#AAAAAA', border='#444444')
        # Refrescar panel histórico si está visible
        try:
            self._refrescar_panel_historico()
        except Exception:
            pass

    def _set_estado(self, txt, color='#00FFCC', bg=C_BG, border=None):
        b = border or color
        self.label_tel.setText(txt)
        self.label_tel.setStyleSheet(
            f"background:{bg};color:{color};"
            f"border:1px solid {b};border-radius:4px;padding:4px;")

    # ══════════════════════════════════════════════════════════════════════════
    # SLOT PRINCIPAL DE DATOS — con motor predictivo + panels en vivo
    # ══════════════════════════════════════════════════════════════════════════
    @pyqtSlot(dict)
    def _datos(self, d):
        try:
            # ══════════════════════════════════════════════════════════════════
            # MOTOR PREDICTIVO: si hay error, fabricamos un dato coherente
            # ══════════════════════════════════════════════════════════════════
            if d.get('error'):
                self._modo_prediccion   = True
                self._ciclos_prediccion += 1

                if self._ciclos_prediccion <= self._MAX_CICLOS_PRED:
                    u = self._ultimo_valido
                    # Bases nunca cero: si el sensor no habia reportado aun, estimar desde corriente
                    v_base   = u['v_proc'] if u['v_proc'] > 0 else max(0.5, u['c_proc'] * 0.02)
                    c_base   = u['c_proc'] if u['c_proc'] > 0 else 1.0
                    vc_base  = u['v_crud'] if u['v_crud'] > 0 else v_base
                    cc_base  = u['c_crud'] if u['c_crud'] > 0 else c_base
                    ref_base = u['ref_sana'] if u['ref_sana'] > 0 else int(c_base)
                    rpm_base = u['rpm']
                    if rpm_base == 0:
                        try:    rpm_base = int(self.input_rpm.text())
                        except: rpm_base = 0

                    ruido_v = np.random.normal(0, max(0.5, v_base * 0.04))
                    ruido_c = np.random.normal(0, max(1.0, c_base * 0.03))

                    d = {
                        'error'    : False,
                        'rpm'      : rpm_base,
                        'v_proc'   : max(0.1, v_base  + ruido_v),
                        'c_proc'   : max(0.1, c_base  + ruido_c),
                        'v_crud'   : max(0.1, vc_base + np.random.normal(0, max(1, vc_base * 0.06))),
                        'c_crud'   : max(0.1, cc_base + np.random.normal(0, max(2, cc_base * 0.05))),
                        'ref_sana' : ref_base,
                        'bin_dom'  : u['bin_dom'],
                        'alertas'  : u['alertas'],
                        '_predicho': True
                    }
                    # ← CRÍTICO: encadenar predicciones — el próximo ciclo predicho
                    # parte desde este dato, no desde el original inmóvil
                    self._ultimo_valido = {k: d.get(k, 0) for k in self._ultimo_valido}
                    self._set_estado(
                        f"⚡  EMI #{self._ciclos_prediccion}  |  RPM: {rpm_base}  |  "
                        f"VIB: {d['v_proc']:.1f}  |  CORR: {d['c_proc']:.1f}  [PRED]",
                        color='#FFD700', bg='#1A1000', border='#886600'
                    )
                else:
                    self._set_estado(
                        f"⚠  RS-485 CAÍDO ({self._ciclos_prediccion} ciclos sin señal)",
                        '#FF3333', bg='#2A0000', border='red'
                    )
                    return
            else:
                # ── Paquete real recibido ─────────────────────────────────────
                # Guard: paquete "válido" pero con todos ceros → probable glitch
                # de frame en el dsPIC; tratarlo como el último conocido
                if d.get('c_proc', 0) == 0 and d.get('v_proc', 0) == 0 and d.get('rpm', 0) == 0:
                    u = self._ultimo_valido
                    d['v_proc']   = u['v_proc']
                    d['c_proc']   = u['c_proc']
                    d['v_crud']   = u['v_crud']
                    d['c_crud']   = u['c_crud']
                    d['rpm']      = u['rpm']
                    d['ref_sana'] = u['ref_sana']
                    d['bin_dom']  = u['bin_dom']

                if self._modo_prediccion:
                    alpha_trans = 0.3
                    d['v_proc'] = alpha_trans * d.get('v_proc', 0) + (1 - alpha_trans) * self._ultimo_valido['v_proc']
                    d['c_proc'] = alpha_trans * d.get('c_proc', 0) + (1 - alpha_trans) * self._ultimo_valido['c_proc']

                self._modo_prediccion   = False
                self._ciclos_prediccion = 0

                # Solo actualizar _ultimo_valido si el paquete trae datos reales
                if d.get('c_proc', 0) > 0 or d.get('v_proc', 0) > 0:
                    self._ultimo_valido = {k: d.get(k, 0) for k in self._ultimo_valido}

                alerta = d.get('alertas', 0)
                if alerta & 0b01:
                    self._sobrecarga_count += 1
                    self._registrar_evento('SOBRECARGA', d)
                    self._set_estado(f"⛔  SOBRECARGA  ({d.get('c_crud',0)} mA)",
                                     '#FF2222', bg='#330000', border='red')
                elif alerta & 0b10:
                    self._desbalance_count += 1
                    self._registrar_evento('DESBALANCE', d)
                    self._set_estado(f"⚠  DESBALANCE  (Bin: {d.get('bin_dom',0)})",
                                     '#FFA500', bg='#2A1800', border='orange')
                else:
                    self._set_estado(
                        f"✅  NORMAL  |  RPM: {d.get('rpm',0)}"
                        f"  |  REF: {d.get('ref_sana',0)} mA"
                        f"  |  VIB: {d.get('v_proc',0):.1f}"
                        f"  |  CORR: {d.get('c_proc',0):.1f} mA",
                        '#00FFCC'
                    )

            # ══════════════════════════════════════════════════════════════════
            # A PARTIR DE AQUÍ usa 'd' sea real o predicho
            # ══════════════════════════════════════════════════════════════════
            rpm_val  = d.get('rpm', 0)
            c_proc   = d.get('c_proc', 0.0)
            v_proc   = d.get('v_proc', 0.0)
            c_crud   = d.get('c_crud', 0.0)
            v_crud   = d.get('v_crud', 0.0)
            ref_sana = d.get('ref_sana', 0)
            bin_dom  = d.get('bin_dom', 0)

            # RPM objetivo para el panel de la pestaña RPM
            try:
                rpm_obj = float(self.input_rpm.text())
            except ValueError:
                rpm_obj = 0.0

            # ── Actualizar panels de datos en vivo ────────────────────────────
            datos_vivo = {
                'v_proc': v_proc, 'c_proc': c_proc,
                'v_crud': v_crud, 'c_crud': c_crud,
                'rpm': rpm_val,   'ref_sana': ref_sana,
                'bin_dom': bin_dom, 'alertas': d.get('alertas', 0),
                'rpm_obj': rpm_obj,
            }
            self.panel_datos_t1.actualizar(datos_vivo)
            self.panel_datos_t2.actualizar(datos_vivo)
            self.panel_datos_ema.actualizar(datos_vivo)
            self.panel_datos_rms.actualizar(datos_vivo)
            self.panel_datos_fft.actualizar(datos_vivo)
            self.panel_datos_rpm.actualizar(datos_vivo)

            # Displays digitales superiores
            self.disp_vib.set_valor(v_proc)
            self.disp_corr.set_valor(c_proc)
            self.disp_rpm.set_valor(rpm_val)

            # FIFO
            self.hist_c_p1.append(c_proc);  self.hist_c_p1.pop(0)
            self.hist_v_p1.append(v_proc);  self.hist_v_p1.pop(0)
            self.hist_c_p2.append(c_crud);  self.hist_c_p2.pop(0)
            self.hist_v_p2.append(v_crud);  self.hist_v_p2.pop(0)

            x = list(range(self.MAX_DATOS))

            # Tab 1
            for col in self.ax_v1.collections[:]: col.remove()
            for col in self.ax_c1.collections[:]: col.remove()
            self.ax_v1.fill_between(x, self.hist_v_p1, color=C_VIB,  alpha=0.10)
            self.ax_c1.fill_between(x, self.hist_c_p1, color=C_CORR, alpha=0.07)
            self.line_v1.set_data(x, self.hist_v_p1)
            self.line_c1.set_data(x, self.hist_c_p1)
            self.line_ref.set_ydata([ref_sana, ref_sana])

            self.matriz_fft = np.roll(self.matriz_fft, -1, axis=1)
            col_f = np.zeros(32)
            # Bin 0 siempre lleva la referencia de corriente sana (señal DC base)
            # escalada al rango de vibración para que sea visible en el espectrograma
            col_f[0] = max(1.0, ref_sana * self.LIM_VIB / max(1, self.LIM_CORR))
            # Bin dominante de vibración + armónicos (siempre, aunque v_proc sea bajo)
            if 0 <= bin_dom < 32:
                amp = max(v_proc / 2.0, 0.5)   # mínimo 0.5 para que siempre sea visible
                col_f[bin_dom] = amp
                if bin_dom > 0:  # no pisamos el bin 0 de referencia
                    if bin_dom * 2 < 32: col_f[bin_dom * 2] = amp * 0.45
                    if bin_dom * 3 < 32: col_f[bin_dom * 3] = amp * 0.20
            self.matriz_fft[:, -1] = col_f
            self.img_fft.set_array(self.matriz_fft)
            self.cv_p1.draw_idle()

            # Tab 2
            for col in self.ax_v2.collections[:]: col.remove()
            for col in self.ax_c2.collections[:]: col.remove()
            self.ax_v2.fill_between(x, self.hist_v_p2, color=C_VIB_RAW,  alpha=0.10)
            self.ax_c2.fill_between(x, self.hist_c_p2, color=C_CORR_RAW, alpha=0.07)
            self.line_v2.set_data(x, self.hist_v_p2)
            self.line_c2.set_data(x, self.hist_c_p2)
            self.cv_p2.draw_idle()

            # Tab 3: EMA
            self.hist_raw_didact.append(v_crud); self.hist_raw_didact.pop(0)
            self.ema_sim += self.alpha_didact * (v_crud - self.ema_sim)
            self.hist_ema_didact.append(self.ema_sim); self.hist_ema_didact.pop(0)
            self.line_raw_ema.set_data(x, self.hist_raw_didact)
            self.line_ema_out.set_data(x, self.hist_ema_didact)
            for col in self.ax_ema.collections[:]: col.remove()
            self.ax_ema.fill_between(x, self.hist_ema_didact, color=C_EMA, alpha=0.12)
            self.cv_ema.draw_idle()

            # Tab 3: RMS
            self.hist_rms_didact.append(c_proc); self.hist_rms_didact.pop(0)
            self.line_rms_hist.set_data(x, self.hist_rms_didact)
            self.line_rms_peak.set_data(x, self.hist_c_p2)
            for bar, h in zip(self.bars_rms, [c_proc, c_crud]):
                bar.set_height(h)
            factor = (c_crud / c_proc) if c_proc > 0 else 0
            self.txt_rms_factor.set_text(f"Factor Pico/RMS: {factor:.2f}")
            self.cv_rms.draw_idle()

            # Tab 3: FFT
            self.fft_bins = np.zeros(32)
            self.fft_bins[0] = max(1.0, ref_sana * self.LIM_VIB / max(1, self.LIM_CORR))
            if 0 <= bin_dom < 32:
                amp = max(v_proc, 0.5)
                self.fft_bins[bin_dom] = amp
                if bin_dom > 0:
                    if bin_dom * 2 < 32: self.fft_bins[bin_dom * 2] = amp * 0.4
                    if bin_dom * 3 < 32: self.fft_bins[bin_dom * 3] = amp * 0.2
            for bar, h in zip(self.bar_fft, self.fft_bins):
                bar.set_height(h)
                bar.set_color('#FF4488' if h == max(self.fft_bins) and h > 0 else '#AA88FF')
            self.img_fft_d.set_array(self.matriz_fft)
            self.cv_fft_d.draw_idle()

            # Tab 3: RPM
            self.hist_rpm_med.append(float(rpm_val)); self.hist_rpm_med.pop(0)
            self.hist_rpm_obj.append(rpm_obj); self.hist_rpm_obj.pop(0)
            self.line_rpm_med.set_data(x, self.hist_rpm_med)
            self.line_rpm_obj.set_data(x, self.hist_rpm_obj)
            self.cv_rpm.draw_idle()

            # ── Tab 4: RUL ────────────────────────────────────────────────────────
            if self._rul_activo:
                self._calcular_rul(c_proc, v_proc, rpm_val)

            # ── BD: guardar muestra y DI ──────────────────────────────────────
            try:
                di_actual = self._hist_di[-1] if self._hist_di else None
                if di_actual is not None:
                    self._di_sesion.append(di_actual)
                es_pred = bool(d.get('_predicho', False))
                self._db.guardar_muestra(self._muestra_sesion, d,
                                         di=di_actual, predicho=es_pred)
                self._muestra_sesion += 1
            except Exception:
                pass

            # ── Firma de arranque ─────────────────────────────────────────────
            try:
                if self._firma and not self._firma.completada:
                    completa = self._firma.agregar_muestra(self._muestra_sesion, d)
                    if completa:
                        sim = self._firma.calcular_similitud(self._firma_ref_vec)
                        self._similitud_sesion = sim
                        res = self._firma.resumen()
                        self._db.guardar_firma(
                            vector     = res['vector_norm'],
                            rpm_pico   = res['rpm_pico'],
                            c_pico     = res['c_pico'],
                            t_estab_s  = res['t_estab_s'],
                            similitud_pct = sim,
                        )
                        try:
                            self._actualizar_panel_firma(res, sim)
                        except Exception:
                            pass
            except Exception:
                pass

        except Exception as e:
            print(f"[_datos] {e}")


# ══════════════════════════════════════════════════════════════════════════════
if __name__ == "__main__":
    app = QApplication(sys.argv)
    v = PanelHMI()
    v.show()
    sys.exit(app.exec_())